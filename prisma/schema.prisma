// Stores raw nutrition label data captured via camera OCR + AI extraction,
// plus the portion-adjusted values the user actually logged.
model ScannedLabel {
  id     String @id @default(uuid())
  userId String

  // Raw label data (as extracted from the photo)
  productName          String?
  ingredients          String? // comma-separated or raw text
  servingSizeG         Float // labeled serving size in grams
  servingsPerContainer Float? // how many servings in the package

  // Nutrition per labeled serving
  labelCalories Float
  labelProteinG Float
  labelCarbsG   Float
  labelFatG     Float
  labelFiberG   Float?
  labelSugarG   Float?
  labelSodiumMg Float?

  // User's actual portion
  actualPortionG Float // what the user actually ate (grams)

  // Adjusted nutrition (computed: actual / servingSize * label values)
  adjCalories Float
  adjProteinG Float
  adjCarbsG   Float
  adjFatG     Float
  adjFiberG   Float?
  adjSugarG   Float?

  // Link to the FoodLog entry created from this scan
  foodLogId String?

  // Metadata
  photoUri     String? // local or cloud URI of the label photo
  ocrRawText   String? // raw OCR text for debugging / reprocessing
  aiConfidence Float? // 0-1 confidence from AI extraction
  mealType     String? // breakfast | lunch | dinner | snack

  // Structured extraction evidence (schemaVersion guards older records)
  schemaVersion   Int   @default(1)
  extraction      Json? // { merged, provenance, conflicts, productConflict, panelCount }
  userCorrections Json? // field-level edits applied during review

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

