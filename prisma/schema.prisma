generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique

  firstName       String?
  lastName        String?

  dateOfBirth     DateTime?

  gender          String?

  heightCm        Float?
  currentWeightKg Float?

  goalType        String?
  activityLevel   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  healthProfile   UserHealthProfile?
  healthConditions UserHealthCondition[]
  allergies       UserAllergy[]
  weightEntries   WeightEntry[]
  dailySteps      DailySteps[]
  waterLogs       WaterLog[]
  sleepLogs       SleepLog[]
  foodLogs        FoodLog[]
  workoutSessions WorkoutSession[]
}

model UserHealthProfile {
  id               String   @id @default(uuid())

  userId           String   @unique

  smoker           Boolean  @default(false)
  drinksAlcohol    Boolean  @default(false)

  sleepGoalHours   Float?

  waterGoalMl      Int?

  notes            String?

  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
}

model HealthCondition {
  id          String @id @default(uuid())

  name        String @unique

  description String?

  userConditions UserHealthCondition[]
  conditionRules ConditionRule[]
  supplementRules SupplementRule[]
}

model UserHealthCondition {
  id            String @id @default(uuid())

  userId        String

  conditionId   String

  severity      String?

  active        Boolean @default(true)

  user          User @relation(fields: [userId], references: [id])

  condition     HealthCondition @relation(fields: [conditionId], references: [id])
}

model Allergy {
  id        String @id @default(uuid())

  name      String @unique

  userAllergies UserAllergy[]
}

model UserAllergy {
  id          String @id @default(uuid())

  userId      String

  allergyId   String

  user         User @relation(fields: [userId], references: [id])

  allergy      Allergy @relation(fields: [allergyId], references: [id])
}

model WeightEntry {
  id           String   @id @default(uuid())

  userId       String

  weightKg     Float

  recordedAt   DateTime @default(now())

  user         User @relation(fields: [userId], references: [id])
}

model DailySteps {
  id            String @id @default(uuid())

  userId        String

  date          DateTime

  steps         Int

  distanceKm    Float?

  user          User @relation(fields: [userId], references: [id])
}

model WaterLog {
  id            String @id @default(uuid())

  userId        String

  amountMl      Int

  loggedAt      DateTime @default(now())

  user          User @relation(fields: [userId], references: [id])
}

model SleepLog {
  id            String @id @default(uuid())

  userId        String

  sleepStart    DateTime

  sleepEnd      DateTime

  hoursSlept    Float?

  sleepScore    Float?

  user          User @relation(fields: [userId], references: [id])
}

model FoodLog {
  id              String @id @default(uuid())

  userId          String

  foodName        String

  quantityG       Float

  calories        Float

  proteinG        Float

  carbsG          Float

  fatG            Float

  fiberG          Float    @default(0)

  mealType        String

  loggedAt        DateTime @default(now())

  user            User @relation(fields: [userId], references: [id])
}

model WorkoutSession {
  id                  String @id @default(uuid())

  userId              String

  workoutType         String

  durationMinutes     Int

  caloriesBurned      Float?

  startedAt           DateTime

  endedAt             DateTime

  user                User @relation(fields: [userId], references: [id])

  exerciseSets        ExerciseSet[]
}

model ExerciseSet {
  id                String @id @default(uuid())

  workoutSessionId  String

  exerciseName      String

  reps              Int

  weightLbs         Float?

  setNumber         Int

  workoutSession    WorkoutSession @relation(fields: [workoutSessionId], references: [id])
}

model Recipe {
  id              String @id @default(uuid())

  creatorId       String

  recipeName      String   @unique

  mealType        String?  // breakfast | lunch | dinner | snack

  cuisine         String?

  description     String?

  servings        Int      @default(1)

  calories        Float?

  proteinG        Float?

  carbsG          Float?

  fatG            Float?

  fiberG          Float?   @default(0)

  portionG        Float?

  isSystem        Boolean  @default(false)

  ingredients     RecipeIngredient[]

  weeklyMeals     WeeklyMeal[]

  createdAt       DateTime @default(now())
}

model RecipeIngredient {
  id              String @id @default(uuid())

  recipeId        String

  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientName  String

  amountG         Float

  calories        Float?

  proteinG        Float?

  carbsG          Float?

  fatG            Float?

  @@index([recipeId])
}

model Recommendation {
  id                 String @id @default(uuid())

  userId             String

  recommendationType String

  recommendationText String

  accepted           Boolean @default(false)

  completed          Boolean @default(false)

  createdAt          DateTime @default(now())
}

model UserInsight {
  id            String @id @default(uuid())

  userId        String

  insight       String

  confidence    Float

  createdAt     DateTime @default(now())
}

model UserEvent {
  id           String @id @default(uuid())

  userId       String

  eventType    String

  eventData    Json?

  createdAt    DateTime @default(now())
}

model Supplement {
  id          String   @id @default(uuid())

  name        String   @unique

  category    String?
  brand       String?
  flavor      String?

  defaultDose   String?
  servingSizeG  Float?

  // Nutrition per serving (from the label).
  calories    Float    @default(0)
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatG        Float    @default(0)
  fiberG      Float    @default(0)

  // Seeded defaults shown first in the catalog; user-added entries are false.
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())

  userLinks         UserSupplement[]
  attributes        SupplementAttribute[]
  supplementRules   SupplementRule[]
  schedules         SupplementSchedule[]
}

// Per-user supplement selections. Users pick which supplements they take.
// Only selected supplements appear on their dashboard.
model UserSupplement {
  id             String   @id @default(uuid())

  userId         String

  supplementId   String
  supplement     Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  // When the user last marked this supplement as taken.
  lastTakenAt    DateTime?

  createdAt      DateTime @default(now())

  @@unique([userId, supplementId])
  @@index([userId])
}

// Central ingredient catalog shared across all users. Populated on demand from
// the USDA FoodData Central API and cached here so repeat lookups (by any user)
// are served from the DB instead of re-hitting USDA.
model Ingredient {
  id              String   @id @default(uuid())

  // USDA FoodData Central ID. Unique so upserts dedupe across users.
  fdcId           String   @unique

  name            String
  // Lowercased name for case-insensitive contains lookups.
  normalizedName  String

  // Nutrition normalized to 100g so any portion can be derived client-side.
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  source          String   @default("usda")

  createdAt       DateTime @default(now())

  userLinks       UserIngredient[]
  attributes      IngredientAttribute[]

  @@index([normalizedName])
}

// Per-user ingredient table: the set of ingredients a given user has searched.
// Lookups check this first, then the central Ingredient table, then USDA.
model UserIngredient {
  id             String   @id @default(uuid())

  userId         String

  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  searchCount    Int      @default(1)
  lastSearchedAt DateTime @default(now())

  createdAt      DateTime @default(now())

  @@unique([userId, ingredientId])
  @@index([userId])
}

// ============================================================================
// SAFETY & RECOMMENDATION ENGINE
// ============================================================================

// Attributes that can be assigned to ingredients (e.g. HIGH_SUGAR, GOITROGENIC).
model IngredientAttribute {
  id             String   @id @default(uuid())

  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  attribute      String   // e.g. HIGH_SUGAR, HIGH_GLYCEMIC, CONTAINS_GLUTEN, NUT, SHELLFISH, etc.

  createdAt      DateTime @default(now())

  @@unique([ingredientId, attribute])
  @@index([attribute])
}

// Attributes that can be assigned to supplements (e.g. CONTAINS_CAFFEINE).
model SupplementAttribute {
  id             String   @id @default(uuid())

  supplementId   String
  supplement     Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  attribute      String   // e.g. CONTAINS_CAFFEINE, HIGH_SODIUM, BLOOD_THINNER_INTERACTION, etc.

  createdAt      DateTime @default(now())

  @@unique([supplementId, attribute])
  @@index([attribute])
}

// Rules that map health conditions to blocked/warned ingredient or supplement attributes.
// action: "block" | "warn"
// target: "ingredient" | "supplement"
model ConditionRule {
  id             String   @id @default(uuid())

  conditionId    String
  condition      HealthCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  // The attribute this rule targets (e.g. HIGH_SUGAR, CONTAINS_CAFFEINE).
  attribute      String

  // "ingredient" or "supplement"
  target         String

  // "block" (hard stop) or "warn" (soft warning)
  action         String

  // Human-readable reason shown to the user.
  reason         String?

  createdAt      DateTime @default(now())

  @@unique([conditionId, attribute, target])
  @@index([conditionId])
}

// Supplement-specific timing/interaction rules (e.g. don't take calcium near thyroid meds).
model SupplementRule {
  id             String   @id @default(uuid())

  supplementId   String
  supplement     Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  conditionId    String?
  condition      HealthCondition? @relation(fields: [conditionId], references: [id])

  // "timing" | "interaction" | "contraindication"
  ruleType       String

  // Human-readable description.
  description    String

  // For timing rules: minimum gap in hours.
  gapHours       Float?

  // What it conflicts with (medication name, supplement name, food category).
  conflictsWith  String?

  createdAt      DateTime @default(now())
}

// Meal recommendations generated by the engine.
model MealRecommendation {
  id              String   @id @default(uuid())

  userId          String

  mealType        String   // breakfast, lunch, dinner, snack
  caloriesTarget  Float
  proteinTarget   Float
  carbsTarget     Float?
  fatTarget       Float?

  // Recommended foods (JSON array of food suggestions).
  foods           Json

  // The reasoning behind the recommendation.
  reasoning       String?

  // Safety score (0-100). Higher = safer based on user's conditions.
  safetyScore     Float    @default(100)

  // Whether the user accepted/dismissed/acted on this.
  status          String   @default("pending") // pending, accepted, dismissed

  createdAt       DateTime @default(now())

  violations      RecommendationViolation[]

  @@index([userId, createdAt])
}

// Violations found during recommendation validation.
model RecommendationViolation {
  id                    String   @id @default(uuid())

  recommendationId      String?
  recommendation        MealRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  userId                String

  // "ingredient" | "supplement" | "recipe" | "meal"
  entityType            String
  entityName            String

  // The attribute that was violated.
  attribute             String

  // The condition that triggered the violation.
  conditionName         String

  // "block" | "warn"
  severity              String

  reason                String?

  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
}

// Audit log for all safety checks run by the system.
model SafetyAuditLog {
  id              String   @id @default(uuid())

  userId          String

  // "meal_recommendation" | "recipe_validation" | "supplement_check" | "ingredient_check"
  checkType       String

  // Input context (JSON).
  input           Json?

  // Result (JSON).
  result          Json?

  safetyScore     Float?

  passed          Boolean  @default(true)

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// Supplement scheduling (dose, time, frequency, reminders).
model SupplementSchedule {
  id              String   @id @default(uuid())

  userId          String

  supplementId    String
  supplement      Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  dose            String   // e.g. "5g", "1 capsule"
  frequency       String   // "daily", "twice_daily", "weekly", "as_needed"
  timeOfDay       String?  // "morning", "afternoon", "evening", "with_meal", "before_bed"

  // Specific time (HH:MM format) for reminders.
  reminderTime    String?

  active          Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, supplementId])
  @@index([userId])
}

// Daily coaching messages generated proactively.
model DailyCoachingMessage {
  id              String   @id @default(uuid())

  userId          String

  // "morning", "afternoon", "evening", "night"
  timeSlot        String

  message         String

  // Category: "protein", "hydration", "calories", "supplement", "recovery", "exercise"
  category        String

  // Whether user has seen/acknowledged it.
  seen            Boolean  @default(false)

  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// RBAC — ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique  // MEMBER, TRAINER, NUTRITIONIST, CREATOR, SUPPORT, ADMIN, SUPER_ADMIN
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================================
// TRAINER SYSTEM
// ============================================================================

model TrainerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  certifications  String[] // Array of cert names
  specialties     String[] // e.g. ["strength", "HIIT", "yoga"]
  yearsExperience Int      @default(0)
  hourlyRate      Float?
  monthlyRateUsd  Float?                          // subscription price per month
  tier            String   @default("standard")   // standard, pro, elite
  location        String?                         // city/region for display
  verified        Boolean  @default(false)
  active          Boolean  @default(true)
  rating          Float?
  ratingCount     Int      @default(0)            // number of ratings received
  profilePicture  String?
  maxClients      Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clients      TrainerClient[]
  workoutPlans WorkoutPlan[]
  coachNotes   CoachNote[]    @relation("TrainerNotes")
  dropForms    TrainerDropForm[]
}

model TrainerClient {
  id           String   @id @default(uuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId     String
  status       String   @default("pending") // pending, active, paused, completed, dropped
  assignedAt   DateTime @default(now())
  startedAt    DateTime @default(now())     // start of current engagement (for progress range)
  lockedUntil  DateTime?                    // first day of next month — client cannot switch until then
  droppedBy    String?                      // "trainer" | "client"
  dropReason   String?                      // JSON summary stored as string
  updatedAt    DateTime @updatedAt

  dropForms    TrainerDropForm[]

  @@unique([trainerId, clientId])
  @@index([trainerId])
  @@index([clientId])
}

// ============================================================================
// TRAINER DROP FORMS & WAITLIST
// ============================================================================

model TrainerDropForm {
  id              String   @id @default(uuid())
  relationId      String   // TrainerClient.id
  relation        TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  trainerId       String
  trainerProfile  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId        String
  droppedBy       String   // "trainer" | "client"

  // Multiple-choice reason codes (e.g. ["non_responsive", "goal_mismatch"])
  reasons         String[]

  // Free-text notes
  notes           String?

  // Trainer-only fields (when droppedBy = "trainer")
  candidateGoals  String?  // recap of candidate's goals for next trainer
  adherenceRating Int?     // 1-5: how well did the client follow the plan?

  // Client-only fields (when droppedBy = "client")
  trainerRating   Int?     // 1-5: how would you rate this trainer?

  createdAt       DateTime @default(now())

  @@index([relationId])
  @@index([clientId])
  @@index([trainerId])
}

// Stub — waitlist not wired up yet; reserved for future "notify me" feature
model TrainerWaitlist {
  id        String   @id @default(uuid())
  userId    String
  trainerId String
  createdAt DateTime @default(now())

  @@unique([userId, trainerId])
  @@index([userId])
  @@index([trainerId])
}

// ============================================================================
// NUTRITIONIST SYSTEM
// ============================================================================

model NutritionistProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String?
  certifications String[]
  specialties    String[]
  verified       Boolean  @default(false)
  active         Boolean  @default(true)
  maxClients     Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients    NutritionistClient[]
  mealPlans  MealPlan[]
  coachNotes CoachNote[] @relation("NutritionistNotes")
}

model NutritionistClient {
  id              String   @id @default(uuid())
  nutritionistId  String
  nutritionist    NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId        String
  status          String   @default("pending") // pending, active, paused, completed
  assignedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([nutritionistId, clientId])
  @@index([nutritionistId])
  @@index([clientId])
}

// ============================================================================
// COACH NOTES
// ============================================================================

model CoachNote {
  id         String   @id @default(uuid())
  coachId    String   // The userId of the trainer or nutritionist
  coachRole  String   // "trainer" or "nutritionist"
  clientId   String
  note       String
  visibility String   @default("private") // private, client_visible
  createdAt  DateTime @default(now())

  // Optional FK to trainer profile (set when coachRole = "trainer")
  trainerId       String?
  trainerProfile  TrainerProfile? @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: SetNull)

  // Optional FK to nutritionist profile (set when coachRole = "nutritionist")
  nutritionistId       String?
  nutritionistProfile  NutritionistProfile? @relation("NutritionistNotes", fields: [nutritionistId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([coachId])
}

// ============================================================================
// WORKOUT PLANS
// ============================================================================

model WorkoutPlan {
  id          String   @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId    String
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises WorkoutPlanExercise[]

  @@index([trainerId])
  @@index([clientId])
}

model WorkoutPlanExercise {
  id            String @id @default(uuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exerciseName  String
  sets          Int
  reps          Int
  targetWeight  Float?
  order         Int    @default(0)

  @@index([workoutPlanId])
}

// ============================================================================
// MEAL PLANS
// ============================================================================

model MealPlan {
  id              String   @id @default(uuid())
  nutritionistId  String
  nutritionist    NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId        String
  title           String?
  active          Boolean  @default(true)
  caloriesTarget  Float
  proteinTarget   Float
  carbsTarget     Float?
  fatTarget       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items MealPlanItem[]

  @@index([nutritionistId])
  @@index([clientId])
}

model MealPlanItem {
  id           String   @id @default(uuid())
  mealPlanId   String
  mealPlan     MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType     String   // breakfast, lunch, dinner, snack
  foodName     String
  ingredientId String?
  quantityG    Float
  calories     Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?

  @@index([mealPlanId])
}

// ============================================================================
// CREATOR SYSTEM
// ============================================================================

model CreatorProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  analytics CreatorAnalytics?
}

model CreatorAnalytics {
  id               String   @id @default(uuid())
  creatorId        String   @unique
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  recipeViews      Int      @default(0)
  recipeUses       Int      @default(0)
  estimatedRevenue Float    @default(0)
  updatedAt        DateTime @updatedAt
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String   // e.g. "role.assign", "client.assign", "plan.create"
  entityType String   // e.g. "UserRole", "TrainerClient", "WorkoutPlan"
  entityId   String?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
}

// ============================================================================
// MACRO SCORE
// ============================================================================

// Per-user macro targets. Users can customize; otherwise defaults are computed.
model MacroGoal {
  id             String   @id @default(uuid())
  userId         String   @unique
  caloriesTarget Float    @default(2200)
  proteinTarget  Float    @default(150)
  carbsTarget    Float    @default(250)
  fatTarget      Float    @default(70)
  fiberTarget    Float    @default(30)
  waterMlTarget  Int      @default(2000)
  source         String   @default("default") // default, custom, trainer, nutritionist
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Cached daily scores so trend queries are fast.
model DailyMacroScore {
  id             String   @id @default(uuid())
  userId         String
  date           String   // YYYY-MM-DD
  overallScore   Float
  proteinScore   Float
  carbsScore     Float
  fatScore       Float
  fiberScore     Float
  hydrationScore Float    @default(0)
  proteinG       Float    @default(0)
  carbsG         Float    @default(0)
  fatG           Float    @default(0)
  fiberG         Float    @default(0)
  waterMl        Int      @default(0)
  calories       Float    @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// ============================================================================
// LEO HEALTH SCORE
// ============================================================================

// The daily explainable health score (replaces raw macro score on dashboard).
model HealthScore {
  id                 String   @id @default(uuid())
  userId             String
  date               String   // YYYY-MM-DD
  score              Float    // 0-100
  status             String   // elite, excellent, good, fair, needs_attention

  // Component scores (each 0-100, weighted into overall)
  macroScore         Float    @default(0)
  conditionScore     Float    @default(0)
  foodQualityScore   Float    @default(0)
  activityScore      Float    @default(0)
  recoveryScore      Float    @default(0)

  createdAt          DateTime @default(now())

  contributors       ScoreContributor[]
  insights           HealthScoreInsight[]

  @@unique([userId, date])
  @@index([userId, date])
}

// Individual items that contributed positively or negatively to the score.
model ScoreContributor {
  id              String   @id @default(uuid())
  healthScoreId   String
  healthScore     HealthScore @relation(fields: [healthScoreId], references: [id], onDelete: Cascade)

  // "macro", "condition", "food_quality", "activity", "recovery"
  category        String
  itemName        String
  scoreImpact     Float    // positive = helped, negative = hurt
  reason          String

  createdAt       DateTime @default(now())

  @@index([healthScoreId])
}

// Human-readable insights summarizing score factors.
model HealthScoreInsight {
  id              String   @id @default(uuid())
  healthScoreId   String
  healthScore     HealthScore @relation(fields: [healthScoreId], references: [id], onDelete: Cascade)

  message         String
  severity        String   // "info", "warning", "critical"

  createdAt       DateTime @default(now())

  @@index([healthScoreId])
}

// ============================================================================
// WEEKLY NUTRITION INTELLIGENCE ENGINE
// ============================================================================

model UserPlanningPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  planGenerationDay  String   @default("sunday")
  planGenerationTime String   @default("06:00")
  mealPrepStyle      String   @default("daily_cooking")
  shoppingDay        String?
  shoppingTime       String?
  budgetLevel        String   @default("medium")
  cookingSkill       String   @default("intermediate")
  householdSize      Int      @default(1)
  availableEquipment String[]
  dietaryRestrictions String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model FoodPreference {
  id          String   @id @default(uuid())
  userId      String
  foodName    String
  preference  String   // LOVE, LIKE, NEUTRAL, DISLIKE, NEVER_RECOMMEND
  createdAt   DateTime @default(now())

  @@unique([userId, foodName])
  @@index([userId])
}

model WeeklyNutritionPlan {
  id              String   @id @default(uuid())
  userId          String
  weekStartDate   String
  status          String   @default("active")
  caloriesTarget  Float
  proteinTarget   Float
  carbsTarget     Float
  fatTarget       Float
  fiberTarget     Float
  waterMlTarget   Int      @default(2000)
  explanation     String?
  createdAt       DateTime @default(now())

  meals           WeeklyMeal[]
  shoppingList    WeeklyShoppingList?
  review          WeeklyReview?

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
}

model WeeklyMeal {
  id              String   @id @default(uuid())
  planId          String
  plan            WeeklyNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  mealType        String
  foodName        String
  portionG        Float
  calories        Float
  proteinG        Float
  carbsG          Float
  fatG            Float
  fiberG          Float    @default(0)
  ingredientId    String?
  recipeId        String?
  recipe          Recipe?  @relation(fields: [recipeId], references: [id])
  confirmedByUser Boolean  @default(false)
  lockedAt        DateTime?
  prepNote        String?

  @@index([planId, dayOfWeek])
  @@index([recipeId])
}

model WeeklyShoppingList {
  id        String   @id @default(uuid())
  planId    String   @unique
  plan      WeeklyNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  items     WeeklyShoppingItem[]
}

model WeeklyShoppingItem {
  id              String   @id @default(uuid())
  shoppingListId  String
  shoppingList    WeeklyShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  foodName        String
  quantityG       Float
  quantityDisplay String
  category        String?
  inInventory     Boolean  @default(false)
  checked         Boolean  @default(false)
  checkedAt       DateTime?

  @@index([shoppingListId])
}

model FoodInventory {
  id             String   @id @default(uuid())
  userId         String
  foodName       String
  ingredientId   String?
  quantityG      Float
  expirationDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, foodName])
  @@index([userId])
}

model DietAdherenceScore {
  id              String   @id @default(uuid())
  userId          String
  weekStartDate   String
  adherencePercent Float
  status          String
  caloriesTarget  Float
  caloriesActual  Float
  proteinTarget   Float
  proteinActual   Float
  mealsPlanned    Int      @default(0)
  mealsLogged     Int      @default(0)
  explanation     String?
  createdAt       DateTime @default(now())

  @@unique([userId, weekStartDate])
  @@index([userId])
}

model CalorieAdjustmentHistory {
  id              String   @id @default(uuid())
  userId          String
  weekStartDate   String
  previousCalories Float
  newCalories     Float
  adjustmentAmount Float
  reason          String
  adherencePercent Float?
  weightTrendKg   Float?
  createdAt       DateTime @default(now())

  @@index([userId, weekStartDate])
}

model WeeklyReview {
  id              String   @id @default(uuid())
  planId          String   @unique
  plan            WeeklyNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId          String
  weekStartDate   String
  weightStart     Float?
  weightEnd       Float?
  caloriesAvg     Float?
  proteinAvg      Float?
  healthScoreAvg  Float?
  compliancePercent Float?
  adherencePercent Float?
  overallResult   String?
  recommendation  String?
  summary         String?
  createdAt       DateTime @default(now())

  recommendations WeeklyRecommendation[]

  @@index([userId, weekStartDate])
}

model WeeklyRecommendation {
  id          String   @id @default(uuid())
  reviewId    String
  review      WeeklyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  category    String
  message     String
  priority    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([reviewId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
