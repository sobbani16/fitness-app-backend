generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  emailVerifiedAt DateTime?
  authActions     AuthAction[]
  passwordHash    String?
  profileData     Json?
  sessions        AuthSession[]

  firstName String?
  lastName  String?

  dateOfBirth DateTime?

  gender String?

  heightCm        Float?
  currentWeightKg Float?

  goalType      String?
  activityLevel String?

  // IANA timezone for local-day boundaries (energy summaries, streaks).
  // Optional — clients may also pass a timezone per request.
  timeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthProfile    UserHealthProfile?
  healthConditions UserHealthCondition[]
  allergies        UserAllergy[]
  weightEntries    WeightEntry[]
  dailySteps       DailySteps[]
  waterLogs        WaterLog[]
  sleepLogs        SleepLog[]
  gutSymptoms      GutSymptom[]
  foodTolerances   FoodTolerance[]
  habits           Habit[]
  wellnessCheckIns WellnessCheckIn[]
  foodLogs         FoodLog[]
  workoutSessions  WorkoutSession[]
  energyRecords    HealthEnergyRecord[]
  workoutPlans     UserWorkoutPlan[]
}

model UserHealthProfile {
  id String @id @default(uuid())

  userId String @unique

  smoker        Boolean @default(false)
  drinksAlcohol Boolean @default(false)

  sleepGoalHours Float?

  waterGoalMl Int?

  notes String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model HealthCondition {
  id String @id @default(uuid())

  name String @unique

  description String?

  userConditions  UserHealthCondition[]
  conditionRules  ConditionRule[]
  supplementRules SupplementRule[]
  nutrientRules   HealthConditionNutrientRule[]
}

model UserHealthCondition {
  id String @id @default(uuid())

  userId String

  conditionId String

  severity String?

  active Boolean @default(true)

  user User @relation(fields: [userId], references: [id])

  condition HealthCondition @relation(fields: [conditionId], references: [id])
}

model Allergy {
  id String @id @default(uuid())

  name String @unique

  userAllergies UserAllergy[]
}

model UserAllergy {
  id String @id @default(uuid())

  userId String

  allergyId String

  user User @relation(fields: [userId], references: [id])

  allergy Allergy @relation(fields: [allergyId], references: [id])
}

model WeightEntry {
  id String @id @default(uuid())

  userId String

  weightKg Float

  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DailySteps {
  id String @id @default(uuid())

  userId String

  date DateTime

  steps Int

  distanceKm Float?

  // Source attribution: 'app' (manual/device sensors today), future 'fitbit',
  // 'apple-health', 'health-connect'. externalId enables provider dedup.
  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model WaterLog {
  id String @id @default(uuid())

  userId String

  amountMl Int

  loggedAt DateTime @default(now())

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model SleepLog {
  id String @id @default(uuid())

  userId String

  sleepStart DateTime

  sleepEnd DateTime

  hoursSlept Float?

  sleepScore Float?

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model FoodLog {
  ingredientId      String?
  nutritionSnapshot Json?
  id                String  @id @default(uuid())

  userId String

  foodName String

  quantityG Float

  calories Float

  proteinG Float

  carbsG Float

  fatG Float

  fiberG Float?

  mealType String

  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WorkoutSession {
  id String @id @default(uuid())

  userId String

  workoutType String

  finishedAt DateTime?

  durationMinutes Int

  caloriesBurned Float?

  startedAt DateTime

  endedAt DateTime

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])

  exerciseSets ExerciseSet[]

  planAssignmentId String? // links actual logged session to a trainer assignment (never required)

  @@index([planAssignmentId])
}

model ExerciseSet {
  id String @id @default(uuid())

  workoutSessionId String

  exerciseName String

  reps Int

  weightLbs Float?

  setNumber Int

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id])
}

model Recipe {
  nutritionSource Json?
  id              String @id @default(uuid())

  creatorId String

  recipeName String @unique

  mealType String? // breakfast | lunch | dinner | snack

  cuisine String?

  description String?

  servings Int @default(1)

  calories Float?

  proteinG Float?

  carbsG Float?

  fatG Float?

  fiberG Float? @default(0)

  portionG Float?

  isSystem Boolean @default(false)

  ingredients RecipeIngredient[]

  weeklyMeals WeeklyMeal[]

  createdAt DateTime @default(now())
}

model RecipeIngredient {
  ingredientId      String?
  nutritionSnapshot Json?
  id                String  @id @default(uuid())

  recipeId String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientName String

  amountG Float

  calories Float?

  proteinG Float?

  carbsG Float?

  fatG Float?

  @@index([recipeId])
}

model Recommendation {
  id String @id @default(uuid())

  userId String

  recommendationType String

  recommendationText String

  accepted Boolean @default(false)

  completed Boolean @default(false)

  createdAt DateTime @default(now())
}

model UserInsight {
  id String @id @default(uuid())

  userId String

  insight String

  confidence Float

  createdAt DateTime @default(now())
}

model UserEvent {
  id String @id @default(uuid())

  userId String

  eventType String

  eventData Json?

  createdAt DateTime @default(now())
}

model Supplement {
  id String @id @default(uuid())

  name String @unique

  category String?
  brand    String?
  flavor   String?

  defaultDose  String?
  servingSizeG Float?

  // Nutrition per serving (from the label).
  calories Float @default(0)
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)
  fiberG   Float @default(0)

  // Seeded defaults shown first in the catalog; user-added entries are false.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  userLinks       UserSupplement[]
  attributes      SupplementAttribute[]
  supplementRules SupplementRule[]
  schedules       SupplementSchedule[]
}

// Per-user supplement selections. Users pick which supplements they take.
// Only selected supplements appear on their dashboard.
model UserSupplement {
  id String @id @default(uuid())

  userId String

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  // When the user last marked this supplement as taken.
  lastTakenAt DateTime?

  createdAt DateTime @default(now())

  logs SupplementLog[]

  @@unique([userId, supplementId])
  @@index([userId])
}

model SupplementLog {
  id String @id @default(uuid())

  userId           String
  userSupplementId String
  userSupplement   UserSupplement @relation(fields: [userSupplementId], references: [id], onDelete: Cascade)

  supplementName String
  quantity       Float  @default(1)
  calories       Float  @default(0)
  proteinG       Float  @default(0)
  carbsG         Float  @default(0)
  fatG           Float  @default(0)
  fiberG         Float  @default(0)

  loggedAt DateTime @default(now())
  date     String

  @@index([userId, date])
  @@index([userSupplementId])
}

// Central ingredient catalog shared across all users. Populated on demand from
// the USDA FoodData Central API and cached here so repeat lookups (by any user)
// are served from the DB instead of re-hitting USDA.
model Ingredient {
  id String @id @default(uuid())

  // USDA FoodData Central ID. Unique so upserts dedupe across users.
  fdcId String? @unique

  name           String
  // Lowercased name for case-insensitive contains lookups.
  normalizedName String

  // Nutrition normalized to 100g so any portion can be derived client-side.
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  source String @default("usda")

  createdAt DateTime @default(now())

  catalogId         String?                      @unique
  catalog           IngredientCatalog?           @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  fiberPer100g      Float?
  sourceMetadata    Json?
  servings          IngredientServing[]
  nutritionProfiles IngredientNutritionProfile[]

  userLinks  UserIngredient[]
  attributes IngredientAttribute[]

  @@index([normalizedName])
}

// Per-user ingredient table: the set of ingredients a given user has searched.
// Lookups check this first, then the central Ingredient table, then USDA.
model UserIngredient {
  id String @id @default(uuid())

  userId String

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  favorite       Boolean   @default(false)
  selectedAt     DateTime?
  searchCount    Int       @default(1)
  lastSearchedAt DateTime  @default(now())

  createdAt DateTime @default(now())

  @@unique([userId, ingredientId])
  @@index([userId])
}

// ============================================================================
// SAFETY & RECOMMENDATION ENGINE
// ============================================================================

// Attributes that can be assigned to ingredients (e.g. HIGH_SUGAR, GOITROGENIC).
model IngredientAttribute {
  id String @id @default(uuid())

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  attribute String // e.g. HIGH_SUGAR, HIGH_GLYCEMIC, CONTAINS_GLUTEN, NUT, SHELLFISH, etc.

  createdAt DateTime @default(now())

  @@unique([ingredientId, attribute])
  @@index([attribute])
}

// Attributes that can be assigned to supplements (e.g. CONTAINS_CAFFEINE).
model SupplementAttribute {
  id String @id @default(uuid())

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  attribute String // e.g. CONTAINS_CAFFEINE, HIGH_SODIUM, BLOOD_THINNER_INTERACTION, etc.

  createdAt DateTime @default(now())

  @@unique([supplementId, attribute])
  @@index([attribute])
}

// Rules that map health conditions to blocked/warned ingredient or supplement attributes.
// action: "block" | "warn"
// target: "ingredient" | "supplement"
model ConditionRule {
  id String @id @default(uuid())

  conditionId String
  condition   HealthCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  // The attribute this rule targets (e.g. HIGH_SUGAR, CONTAINS_CAFFEINE).
  attribute String

  // "ingredient" or "supplement"
  target String

  // "block" (hard stop) or "warn" (soft warning)
  action String

  // Human-readable reason shown to the user.
  reason String?

  // Legacy attribute rules are not approved clinical evidence by default.
  ruleCode                String?              @unique
  clinicalAction          NutrientRuleAction?
  clinicalSeverity        NutrientRuleSeverity @default(INFO)
  applicabilityCriteria   Json?
  requiresPersonalization Boolean              @default(false)
  evidenceSourceId        String?              @db.Uuid
  evidence                RuleEvidence?        @relation(fields: [evidenceSourceId], references: [id], onDelete: Restrict)
  reviewStatus            ClinicalRuleReview   @default(DRAFT)
  version                 Int                  @default(1)
  reviewedBy              String?
  reviewedAt              DateTime?

  createdAt DateTime @default(now())

  @@unique([conditionId, attribute, target])
  @@index([conditionId])
}

// Supplement-specific timing/interaction rules (e.g. don't take calcium near thyroid meds).
model SupplementRule {
  id String @id @default(uuid())

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  conditionId String?
  condition   HealthCondition? @relation(fields: [conditionId], references: [id])

  // "timing" | "interaction" | "contraindication"
  ruleType String

  // Human-readable description.
  description String

  // For timing rules: minimum gap in hours.
  gapHours Float?

  // What it conflicts with (medication name, supplement name, food category).
  conflictsWith String?

  createdAt DateTime @default(now())
}

// Meal recommendations generated by the engine.
model MealRecommendation {
  id String @id @default(uuid())

  userId String

  mealType       String // breakfast, lunch, dinner, snack
  caloriesTarget Float
  proteinTarget  Float
  carbsTarget    Float?
  fatTarget      Float?

  // Recommended foods (JSON array of food suggestions).
  foods Json

  // The reasoning behind the recommendation.
  reasoning String?

  // Safety score (0-100). Higher = safer based on user's conditions.
  safetyScore Float @default(100)

  // Whether the user accepted/dismissed/acted on this.
  status String @default("pending") // pending, accepted, dismissed

  createdAt DateTime @default(now())

  violations RecommendationViolation[]

  @@index([userId, createdAt])
}

// Violations found during recommendation validation.
model RecommendationViolation {
  id String @id @default(uuid())

  recommendationId String?
  recommendation   MealRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  userId String

  // "ingredient" | "supplement" | "recipe" | "meal"
  entityType String
  entityName String

  // The attribute that was violated.
  attribute String

  // The condition that triggered the violation.
  conditionName String

  // "block" | "warn"
  severity String

  reason String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Audit log for all safety checks run by the system.
model SafetyAuditLog {
  id String @id @default(uuid())

  userId String

  // "meal_recommendation" | "recipe_validation" | "supplement_check" | "ingredient_check"
  checkType String

  // Input context (JSON).
  input Json?

  // Result (JSON).
  result Json?

  safetyScore Float?

  passed Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Supplement scheduling (dose, time, frequency, reminders).
model SupplementSchedule {
  id String @id @default(uuid())

  userId String

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  dose      String // e.g. "5g", "1 capsule"
  frequency String // "daily", "twice_daily", "weekly", "as_needed"
  timeOfDay String? // "morning", "afternoon", "evening", "with_meal", "before_bed"

  // Specific time (HH:MM format) for reminders.
  reminderTime String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, supplementId])
  @@index([userId])
}

// Daily coaching messages generated proactively.
model DailyCoachingMessage {
  id String @id @default(uuid())

  userId String

  // "morning", "afternoon", "evening", "night"
  timeSlot String

  message String

  // Category: "protein", "hydration", "calories", "supplement", "recovery", "exercise"
  category String

  // Whether user has seen/acknowledged it.
  seen Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// RBAC — ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // MEMBER, TRAINER, NUTRITIONIST, CREATOR, SUPPORT, ADMIN, SUPER_ADMIN
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================================
// TRAINER SYSTEM
// ============================================================================

model TrainerProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  bio               String?
  certifications    String[] // Array of cert names
  specialties       String[] // e.g. ["strength", "HIIT", "yoga"]
  yearsExperience   Int       @default(0)
  hourlyRate        Float?
  tier              String    @default("standard") // standard, pro, elite
  location          String? // city/region for display
  verified          Boolean   @default(false)
  active            Boolean   @default(true)
  rating            Float?
  ratingCount       Int       @default(0) // number of ratings received
  profilePicture    String?
  maxClients        Int       @default(10)
  displayName       String?
  country           String?
  timeZone          String?
  languages         String[]  @default([])
  coachingMode      String    @default("both") // online | in_person | both
  website           String?
  philosophy        String?
  isDiscoverable    Boolean   @default(true)
  applicationStatus String    @default("submitted") // draft | submitted | under_review | approved | rejected | changes_requested
  applicationNote   String?
  approvedAt        DateTime?
  approvedBy        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clients          TrainerClient[]
  workoutPlans     WorkoutPlan[]
  coachNotes       CoachNote[]                  @relation("TrainerNotes")
  dropForms        TrainerDropForm[]
  certificationsV2 TrainerCertification[]
  availabilities   TrainerAvailability[]
  sessionTypes     TrainerSessionType[]
  schedulingPref   TrainerSchedulingPreference?
  packages         TrainerCoachingPackage[]
  payouts          TrainerPayout[]
  nutritionPlans   TrainerNutritionPlan[]
  coachingGroups  CoachingGroup[]
  documents       TrainerDocument[]
}


model TrainerClient {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId    String
  status      String         @default("pending") // pending, active, paused, completed, dropped
  requestedBy String? // "client" | "trainer" — who initiated the request
  assignedAt  DateTime       @default(now())
  startedAt   DateTime       @default(now()) // start of current engagement (for progress range)
  lockedUntil DateTime? // first day of next month — client cannot switch until then
  droppedBy   String? // "trainer" | "client"
  dropReason  String? // JSON summary stored as string
  updatedAt   DateTime       @updatedAt

  dropForms    TrainerDropForm[]
  consents     TrainerClientConsent[]
  conversation Conversation?
  bookings     TrainerBooking[]
  checkIns     CheckIn[]

  videoSessions   VideoSession[]
  documentShares  TrainerDocumentShare[]

  @@unique([trainerId, clientId])
  @@index([trainerId])
  @@index([clientId])
}

// ============================================================================
// TRAINER DROP FORMS & WAITLIST
// ============================================================================
model TrainerDropForm {
  id             String         @id @default(uuid())
  relationId     String // TrainerClient.id
  relation       TrainerClient  @relation(fields: [relationId], references: [id], onDelete: Cascade)
  trainerId      String
  trainerProfile TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId       String
  droppedBy      String // "trainer" | "client"

  // Multiple-choice reason codes (e.g. ["non_responsive", "goal_mismatch"])
  reasons String[]

  // Free-text notes
  notes String?

  // Trainer-only fields (when droppedBy = "trainer")
  candidateGoals  String? // recap of candidate's goals for next trainer
  adherenceRating Int? // 1-5: how well did the client follow the plan?

  // Client-only fields (when droppedBy = "client")
  trainerRating Int? // 1-5: how would you rate this trainer?

  createdAt DateTime @default(now())

  @@index([relationId])
  @@index([clientId])
  @@index([trainerId])
}

// Stub — waitlist not wired up yet; reserved for future "notify me" feature
model TrainerWaitlist {
  id        String   @id @default(uuid())
  userId    String
  trainerId String
  createdAt DateTime @default(now())

  @@unique([userId, trainerId])
  @@index([userId])
  @@index([trainerId])
}

// ============================================================================
// NUTRITIONIST SYSTEM
// ============================================================================

model NutritionistProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String?
  certifications String[]
  specialties    String[]
  verified       Boolean  @default(false)
  active         Boolean  @default(true)
  maxClients     Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients    NutritionistClient[]
  mealPlans  MealPlan[]
  coachNotes CoachNote[]          @relation("NutritionistNotes")
}

model NutritionistClient {
  id             String              @id @default(uuid())
  nutritionistId String
  nutritionist   NutritionistProfile @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  clientId       String
  status         String              @default("pending") // pending, active, paused, completed
  assignedAt     DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([nutritionistId, clientId])
  @@index([nutritionistId])
  @@index([clientId])
}

// ============================================================================
// COACH NOTES
// ============================================================================

model CoachNote {
  id         String   @id @default(uuid())
  coachId    String // The userId of the trainer or nutritionist
  coachRole  String // "trainer" or "nutritionist"
  clientId   String
  note       String
  visibility String   @default("private") // private, client_visible
  createdAt  DateTime @default(now())

  // Optional FK to trainer profile (set when coachRole = "trainer")
  trainerId      String?
  trainerProfile TrainerProfile? @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: SetNull)

  // Optional FK to nutritionist profile (set when coachRole = "nutritionist")
  nutritionistId      String?
  nutritionistProfile NutritionistProfile? @relation("NutritionistNotes", fields: [nutritionistId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([coachId])
}

// ============================================================================
// WORKOUT PLANS
// ============================================================================

model WorkoutPlan {
  id            String         @id @default(uuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId      String? // null for template plans not yet assigned
  title         String
  description   String?
  active        Boolean        @default(true)
  status        String         @default("published") // draft | published | archived
  goal          String?
  difficulty    String? // beginner | intermediate | advanced
  durationWeeks Int?
  daysPerWeek   Int?
  startAt       DateTime?
  endAt         DateTime?
  version       Int            @default(1)
  supersedesId  String?
  supersedes    WorkoutPlan?   @relation("PlanVersions", fields: [supersedesId], references: [id])
  supersededBy  WorkoutPlan[]  @relation("PlanVersions")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  exercises   WorkoutPlanExercise[]
  days        TrainerWorkoutDay[]
  assignments TrainerWorkoutAssignment[]

  @@index([trainerId])
  @@index([clientId])
}

model TrainerWorkoutDay {
  id       String      @id @default(uuid())
  planId   String
  plan     WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayIndex Int // 0..daysPerWeek-1
  label    String? // e.g. "Push Day", "Legs"
  warmup   String?
  cooldown String?
  notes    String?

  exercises TrainerWorkoutExercise[]

  @@unique([planId, dayIndex])
}

model TrainerWorkoutExercise {
  id             String            @id @default(uuid())
  dayId          String
  day            TrainerWorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseName   String
  exerciseId     String? // optional link into Exercise catalog
  sets           Int
  reps           Int?
  repsText       String? // e.g. "8-12"
  targetWeight   Float?
  weightGuidance String? // e.g. "RPE 7", "increase 5lb weekly"
  restSeconds    Int?
  tempo          String? // e.g. "3-1-1"
  progression    String?
  order          Int               @default(0)

  @@index([dayId])
}

model TrainerWorkoutAssignment {
  id          String      @id @default(uuid())
  planId      String
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  clientId    String
  status      String      @default("assigned") // assigned | accepted | declined | completed | archived
  assignedAt  DateTime    @default(now())
  respondedAt DateTime?

  feedback TrainerWorkoutFeedback[]

  @@index([planId])
  @@index([clientId])
}

model TrainerWorkoutFeedback {
  id               String                   @id @default(uuid())
  assignmentId     String
