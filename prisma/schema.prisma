  type            String // checkout | payment | refund | payout | subscription_update
  payload         Json?
  createdAt       DateTime        @default(now())

  @@index([purchaseId])
}

model TrainerPayout {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id])
  amountCents Int
  currency    String         @default("usd")
  status      String         @default("pending") // pending | processing | paid | failed
  providerRef String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime       @default(now())

  @@index([trainerId])
}

model TrainerRefund {
  id          String          @id @default(uuid())
  purchaseId  String
  purchase    TrainerPurchase @relation(fields: [purchaseId], references: [id])
  amountCents Int
  reason      String?
  status      String          @default("pending") // pending | processed | failed
  createdAt   DateTime        @default(now())
}

model TrainerPromotion {
  id             String    @id @default(uuid())
  code           String    @unique
  percentOff     Int?
  amountOffCents Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ============================================================================
// COACHING CHECK-INS (member → trainer structured weekly reviews)
// ============================================================================

model CheckIn {
  id                String        @id @default(uuid())
  relationId        String
  relation          TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  clientId          String
  weekOf            DateTime // Monday (UTC) the check-in covers
  goalProgress      String? // member self-assessment vs goal
  workoutDifficulty Int? // 1-5 perceived difficulty
  energyLevel       Int? // 1-5 recovery/energy
  weightKg          Float? // optional weight update
  questions         String?
  challenges        String?
  notes             String?
  reviewedAt        DateTime?
  reviewedBy        String?
  trainerReply      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([relationId, weekOf])
  @@index([clientId])
  @@index([relationId])
}

// ---------------------------------------------------------------------------
// Coaching communication platform (web) — groups, documents, video sessions.
// DM conversations reuse existing Conversation/Message models above.
// ---------------------------------------------------------------------------

model CoachingGroup {
  id        String         @id @default(uuid())
  name      String
  kind      String         @default("coaching") // coaching|cohort|challenge|nutrition
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  status    String         @default("active") // active|archived
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  members        CoachingGroupMember[]
  messages       GroupMessage[]
  readCursors    GroupReadCursor[]
  documentShares TrainerDocumentShare[]

  @@index([trainerId, status])
}

model CoachingGroupMember {
  id        String        @id @default(uuid())
  groupId   String
  group     CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  role      String        @default("member") // member|moderator|owner
  status    String        @default("invited") // invited|active|left|removed
  invitedBy String?
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime      @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
}

model GroupMessage {
  id        String        @id @default(uuid())
  groupId   String
  group     CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  deletedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([groupId, id])
}

model GroupReadCursor {
  groupId           String
  group             CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String
  lastReadMessageId String?
  updatedAt         DateTime      @updatedAt

  @@id([groupId, userId])
}

model MessageReport {
  id          String    @id @default(uuid())
  messageKind String // dm|group
  messageId   String
  reporterId  String
  reason      String
  status      String    @default("open") // open|resolved|dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model TrainerDocument {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String         @default("education") // nutrition|workout|meal_plan|exercise|progress|education
  fileKey     String // storage-relative key (never exposed)
  fileName    String
  mimeType    String         @default("application/pdf")
  sizeBytes   Int
  version     Int            @default(1)
  status      String         @default("active") // active|revoked
  uploadedAt  DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  shares TrainerDocumentShare[]

  @@index([trainerId, status])
}

model TrainerDocumentShare {
  id         String          @id @default(uuid())
  documentId String
  document   TrainerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relationId String? // share with one coaching relationship
  relation   TrainerClient?  @relation(fields: [relationId], references: [id], onDelete: Cascade)
  groupId    String?
  group      CoachingGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([documentId])
  @@index([relationId])
  @@index([groupId])
}

model VideoSession {
  id                 String        @id @default(uuid())
  relationId         String
  relation           TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  roomName           String        @unique
  purpose            String?
  scheduledStart     DateTime
  scheduledEnd       DateTime
  status             String        @default("scheduled") // scheduled|live|ended|cancelled
  recordingRequested Boolean       @default(false)
  recordingStartedAt DateTime?
  recordingEndedAt   DateTime?
  endedAt            DateTime?
  exerciseKey        String? // optional exercise-demo ref from the exercise library
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  consents RecordingConsent[]
  summary  VideoSessionSummary?

  @@index([relationId, scheduledStart])
  @@index([status])
}

model RecordingConsent {
  id             String       @id @default(uuid())
  videoSessionId String
  videoSession   VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  userId         String
  granted        Boolean
  policyVersion  String
  withdrawnAt    DateTime?
  createdAt      DateTime     @default(now())

  @@unique([videoSessionId, userId])
}

model VideoSessionSummary {
  id             String       @id @default(uuid())
  videoSessionId String       @unique
  videoSession   VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  memberSummary  String?
  actionItems    Json?
  privateNotes   String?
  publishedAt    DateTime?
  updatedAt      DateTime     @updatedAt
}

// ============================================================================
// KNOWLEDGE ACADEMY — research-backed education (editorial workflow)
// ============================================================================

model ResearchSource {
  id             String            @id @default(uuid())
  key            String            @unique // doi:<doi> | pmid:<id> | url:<stable-url>
  title          String
  authors        Json?
  journal        String?
  year           Int?
  doi            String?
  pmid           String?
  url            String?
  studyType      String? // guideline|meta_analysis|rct|cohort|review|position_stand
  population     String?
  intervention   String?
  comparator     String?
  outcomes       String?
  resultsSummary String?
  limitations    String?
  status         String            @default("active") // active|retracted|corrected|unavailable
  verifiedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  evidenceLinks  ArticleEvidence[]

  @@index([status])
}

model KnowledgeArticle {
  id                  String    @id @default(uuid())
  slug                String    @unique
  category            String
  tags                Json      @default("[]")
  status              String    @default("draft") // draft|researching|ready_for_review|changes_requested|approved|scheduled|published|correction_required|retracted|archived
  authorId            String
  reviewerId          String?
  currentRevisionId   String?
  approvedRevisionId  String? // immutable pointer set on approval
  publishedRevisionId String?
  publishedAt         DateTime?
  lastReviewedAt      DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  revisions   KnowledgeArticleRevision[]
  reviews     ArticleReview[]
  schedule    EditorialSchedule[]
  savedBy     KnowledgeSavedItem[]
  corrections ContentCorrection[]
  faqs        KnowledgeFAQ[]

  @@index([status, publishedAt])
  @@index([category, status])
}

model KnowledgeArticleRevision {
  id                 String           @id @default(uuid())
  articleId          String
  article            KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version            Int
  title              String
  claim              String // the myth/common claim being examined
  verdict            String // MYTH|MOSTLY_MYTH|CONTEXT_DEPENDENT|MOSTLY_SUPPORTED|SUPPORTED|INSUFFICIENT_EVIDENCE
  shortVerdict       String // one-sentence explanation
  explanation        String // what the evidence suggests, plain language
  takeaway           String? // practical takeaway
  appliesTo          String? // who the finding applies to
  exceptions         String? // important exceptions
  uncertainty        String? // conflicting findings / gaps
  certainty          String           @default("NOT_ASSESSED") // HIGH|MODERATE|LOW|VERY_LOW|NOT_ASSESSED
  certaintyRationale String? // reviewer rationale — required when certainty assessed
  aiAssisted         Boolean          @default(false)
  immutable          Boolean          @default(false) // frozen at approval — scheduled/published refs point here
  createdById        String
  createdAt          DateTime         @default(now())

  evidence    ArticleEvidence[]
  reviews     ArticleReview[]
  schedule    EditorialSchedule[]
  events      PublicationEvent[]
  corrections ContentCorrection[]

  @@unique([articleId, version])
  @@index([articleId])
}

model ArticleEvidence {
  id         String                   @id @default(uuid())
  revisionId String
  revision   KnowledgeArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceId   String
  source     ResearchSource           @relation(fields: [sourceId], references: [id])
  supports   String? // which claim/section it backs
  position   Int                      @default(0)

  @@unique([revisionId, sourceId])
  @@index([sourceId])
}

model ArticleReview {
  id         String                   @id @default(uuid())
  articleId  String
  article    KnowledgeArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId String
  revision   KnowledgeArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewerId String
  decision   String // approved|changes_requested
  feedback   Json? // field-specific comments
  scope      String? // clinical|general — reviewers' declared scope for this review
  createdAt  DateTime                 @default(now())

  @@index([articleId, createdAt])
  @@index([reviewerId, createdAt])
}

model ReviewerProfile {
  userId         String   @id
  expertise      Json     @default("[]") // topic keys the reviewer covers
  qualifications String? // self-declared; NOT verified credentials
  conflicts      String? // disclosed conflicts of interest
  clinical       Boolean  @default(false) // eligible for clinical-scope reviews
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EditorialSchedule {
  id            String                   @id @default(uuid())
  publishKey    String                   @unique // idempotency: e.g. weekly:2026-45
  articleId     String
  article       KnowledgeArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId    String
  revision      KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  scheduledFor  DateTime
  status        String                   @default("scheduled") // scheduled|published|cancelled|blocked|withdrawn
  blockedReason String?
  publishedAt   DateTime?
  createdById   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, scheduledFor])
}

model PublicationEvent {
  id           String                   @id @default(uuid())
  scheduleId   String?                  @unique // one event per schedule → idempotent
  articleId    String
  revisionId   String
  revision     KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  kind         String                   @default("weekly") // weekly|correction|republication
  scheduledFor DateTime
  publishedAt  DateTime                 @default(now())
  notifiedAt   DateTime?

  @@index([articleId, publishedAt])
}

model KnowledgeFAQ {
  id                String            @id @default(uuid())
  canonicalQuestion String            @unique
  aliases           Json              @default("[]")
  shortAnswer       String
  detail            String?
  topicTags         Json              @default("[]")
  articleId         String?
  article           KnowledgeArticle? @relation(fields: [articleId], references: [id])
  sourceKeys        Json              @default("[]") // ResearchSource.key list — validated on write
  certainty         String            @default("NOT_ASSESSED")
  status            String            @default("draft") // draft|published|retired
  language          String            @default("en")
  version           Int               @default(1)
  lastReviewedAt    DateTime?
  reviewerId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
}

model KnowledgeSavedItem {
  id        String           @id @default(uuid())
  userId    String
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, articleId])
}

model KnowledgeQuestionSuggestion {
  id        String   @id @default(uuid())
  userId    String?
  question  String
  status    String   @default("open") // open|reviewed|answered|declined
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ContentCorrection {
  id                 String                   @id @default(uuid())
  articleId          String
  article            KnowledgeArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId         String
  revision           KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  kind               String // retraction|guideline_change|new_evidence|error|source_unavailable
  detail             String
  status             String                   @default("open") // open|corrected|withdrawn
  createdById        String
  resolvedRevisionId String?
  createdAt          DateTime                 @default(now())
  resolvedAt         DateTime?

  @@index([status])
}

// ============================================================================
// MODULAR MEMBERSHIPS — server-side entitlement engine
// ============================================================================

model MembershipModule {
  key         String  @id // FREE_CORE|NUTRITION|WORKOUTS|EXERCISE_LIBRARY|ADVANCED_VIDEO_GUIDANCE|LEO_AI|ADVANCED_ANALYTICS|TRAINER_COACHING|LIVE_SESSIONS|KNOWLEDGE_PREMIUM
  name        String
  description String?
  sortOrder   Int     @default(0)
}

model MembershipPackage {
  id             String    @id @default(uuid())
  key            String    @unique // free|nutrition|workout|nutrition_workout|full|ai_addon|byot|trainer_coached
  name           String
  description    String?
  modules        Json      @default("[]") // MembershipModule.key list
  trialDays      Int       @default(0)
  active         Boolean   @default(false) // draft until activated
  platforms      Json      @default("[]") // ios|android|web availability
  storeIds       Json      @default("{}") // {appStore, playStore, web} provider product ids — set at sale time
  displayCopy    Json?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UserEntitlement {
  id          String    @id @default(uuid())
  userId      String
  moduleKey   String
  source      String // purchase|trial|complimentary|admin_grant|trainer_relationship
  status      String    @default("active") // active|grace|expired|revoked
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // null = no expiry (e.g. free core)
  packageKey  String?
  purchaseRef String? // provider transaction id — dedupe key with provider
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, moduleKey, status])
  @@index([status, endsAt])
}

model EntitlementEvent {
  id              String   @id @default(uuid())
  userId          String
  moduleKey       String
  packageKey      String?
  event           String // purchase|activation|renewal|upgrade|downgrade|cancellation|expiration|refund|grant|revoke|trial_start|trial_end
  payload         Json?
  providerEventId String?  @unique // idempotent provider webhook reconciliation
  occurredAt      DateTime
  processedAt     DateTime @default(now())
  actorId         String?

  @@index([userId, occurredAt])
}

// Member's chosen coaching model (Trainer Partnership Mode).
model CoachingPreference {
  userId                   String   @id
  model                    String   @default("self_guided") // self_guided|humai_assisted|trainer_led|hybrid
  // hybrid only: whose plan surfaces first when both trainer + Humai plans exist.
  planPrecedence           String   @default("trainer_first") // trainer_first|humai_first
  // Whether Humai-generated insights may be shown to the trainer workspace.
  shareInsightsWithTrainer Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model ActionFeedback {
  id        String   @id @default(uuid())
  userId    String
  actionKey String
  verdict   String
  createdAt DateTime @default(now())

  @@index([userId, actionKey, createdAt])
}

// Gut health — member symptom journal. Never infers causality; severity 1-5.
model GutSymptom {
  id       String   @id @default(uuid())
  userId   String
  symptom  String // bloating|gas|constipation|diarrhea|reflux|abdominal|stool_frequency
  severity Int      @default(3)
  bristol  Int? // optional Bristol Stool Form 1-7
  note     String?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// Individualized food tolerance — DISTINCT from the Allergy model.
// kind: suspected|intolerance|dislike|exclusion (allergy lives in Allergy).
model FoodTolerance {
  id        String   @id @default(uuid())
  userId    String
  foodName  String
  kind      String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// User-selected habit coaching — no streak punishment, pause/snooze friendly.
model Habit {
  id           String            @id @default(uuid())
  userId       String
  title        String
  kind         String            @default("custom") // fiber|workout|sleep_window|meal_prep|movement_break|reflection|supplement|custom
  daysOfWeek   Int               @default(127) // bitmask Mon=1..Sun=64, 127=daily
  status       String            @default("active") // active|paused|archived
  snoozedUntil DateTime?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions  HabitCompletion[]

  @@index([userId, status])
}

model HabitCompletion {
  id      String @id @default(uuid())
  habitId String
  day     String // YYYY-MM-DD local day
  outcome String @default("done") // done|skipped
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
}

// Wellness check-in — self-reported stress/mood/fatigue. Never diagnostic,
// never auto-shared with trainers.
model WellnessCheckIn {
  id       String   @id @default(uuid())
  userId   String
  stress   Int // 1-5
  mood     Int // 1-5
  fatigue  Int // 1-5
  note     String?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// ============================================================================
// COACHING LOOP — intake, shared outcome plans, form checks (M12/M13/M16)
// ============================================================================

// Coaching intake — progressive baseline assessment per relationship.
// `data` holds only the sections filled so far (never required up front).
// Rows are version snapshots: edits after submit create version+1, history
// is never overwritten. Private health conditions are NOT auto-attached —
// sharing stays governed by TrainerClientConsent.
model BaselineAssessment {
  id           String        @id @default(uuid())
  relationId   String
  relation     TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  trainerId    String
  clientId     String
  version      Int           @default(1)
  status       String        @default("in_progress") // in_progress|submitted|reviewed
  data         Json          @default("{}")
  supersedesId String?
  updatedBy    String?
  submittedAt  DateTime?
  submittedBy  String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([relationId, version])
  @@index([clientId])
  @@index([trainerId])
}

// Shared outcome plan — explicit trainer+member agreement. One active plan
// per relationship; every revision supersedes the previous version and logs
// an OutcomePlanAdjustment (member-visible change history).
model OutcomePlan {
  id           String        @id @default(uuid())
  relationId   String
  relation     TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  trainerId    String
  clientId     String
  version      Int           @default(1)
  status       String        @default("active") // active|superseded|completed|archived
  note         String?
  supersedesId String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  goals       OutcomeGoal[]
  adjustments OutcomePlanAdjustment[]

  @@unique([relationId, version])
  @@index([clientId, status])
  @@index([trainerId, status])
}

// Outcome goal — baseline/target may be free text or numbers; not every goal
// needs a numeric score. progressSource says where progress evidence lives.
model OutcomeGoal {
  id                 String      @id @default(uuid())
  planId             String
  plan               OutcomePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind               String      @default("custom") // workout_consistency|strength|functional_movement|dietary_habit|weight_trend|sleep_regularity|confidence|custom
  title              String
  baseline           String?
  target             String?
  targetDate         DateTime?
  reviewIntervalDays Int         @default(7)
  progressSource     String      @default("self_report") // workout_records|weight_trends|check_ins|habit_completions|self_report|trainer_assessment
  notes              String?
  status             String      @default("open") // open|met|dropped
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())

  @@index([planId])
}

model OutcomePlanAdjustment {
  id         String      @id @default(uuid())
  planId     String // the version this adjustment produced
  plan       OutcomePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  adjustedBy String // userId of who made the change
  summary    String
  createdAt  DateTime    @default(now())

  @@index([planId])
}

// Exercise form check — trainer requests, member uploads a video with
// explicit consent, trainer leaves timestamped feedback. Video bytes live in
// private docStorage; access goes through short-lived signature-checked URLs.
model FormCheckRequest {
  id           String        @id @default(uuid())
  relationId   String
  relation     TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  trainerId    String
  clientId     String
  exerciseKey  String? // Exercise.id from the library, when linked
  exerciseName String?
  note         String? // trainer's technique notes / what to film
  status       String        @default("requested") // requested|submitted|reviewed|declined
  videoKey     String? // docStorage key — never exposed in responses
  videoName    String?
  videoMime    String?
  videoBytes   Int?
  consentAt    DateTime? // when the member consented to share the video
  submittedAt  DateTime?
  reviewedAt   DateTime?
  memberAckAt  DateTime? // member confirmed they understood the feedback
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  feedback FormCheckFeedback[]

  @@index([clientId, status])
  @@index([trainerId, status])
  @@index([relationId])
}

model FormCheckFeedback {
  id           String           @id @default(uuid())
  requestId    String
  request      FormCheckRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId     String // trainer userId
  timestampSec Float? // position in the video; null = general note
  note         String
  createdAt    DateTime         @default(now())

  @@index([requestId])
}

// Weekly personal health review — generated on demand for a member's own
// week (Mon–Sun). Separate from the public Myth vs Fact publication and
// from the plan-scoped WeeklyReview. `data` carries the composed review;
// progress is only claimed when records support it.
model WeeklyHealthReview {
  id        String    @id @default(uuid())
  userId    String
  weekOf    DateTime // Monday (UTC) of the reviewed week
  data      Json      @default("{}")
  openedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, weekOf])
  @@index([userId, createdAt])
}

// ============================================================================
// MIND & HABITS — opt-in emotional wellness (non-diagnostic). Journals are
// private: never shared with trainers or sent to AI providers without the
// dedicated consents on UserMindPreferences.
// ============================================================================
model EmotionalCheckIn {
  id          String   @id @default(uuid())
  userId      String
  mood        String // very_low|low|neutral|good|very_good
  energy      Int // 1-5
  stress      Int // 1-5 perceived
  emotionTags Json     @default("[]") // e.g. ["calm","anxious","proud"]
  contextTags Json     @default("[]") // work|family|exercise|sleep|relationships|other
  journal     String? // private journal text — access-logged, consent-gated
  timezone    String   @default("UTC")
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, loggedAt])
}

model UserMindPreferences {
  userId                String   @id
  moduleEnabled         Boolean  @default(true)
  remindersEnabled      Boolean  @default(false)
  aiJournalConsent      Boolean  @default(false) // separate informed consent for AI processing of journals
  checkinSharingConsent Boolean  @default(false) // separate consent for trainer sharing
  reminderTimeLocal     String? // "HH:MM" local wall-clock time
  reminderTimeZone      String? // IANA zone, e.g. Asia/Kolkata
  reminderPaused        Boolean  @default(false)
  quietHoursStart       String? // "HH:MM" — no reminders inside quiet hours
  quietHoursEnd         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MindExerciseCompletion {
  id          String   @id @default(uuid())
  userId      String
  exerciseKey String
  trackKey    String // self_awareness|self_management|social_awareness|relationship_management
  reflection  String?
  completedAt DateTime @default(now())

  @@index([userId, completedAt])
}

// ============================================================================
// FOOD INTELLIGENCE — barcode resolution + reviewed ingredient evidence.
// Only APPROVED/ACTIVE profiles surface as established conclusions.
// ============================================================================
model BarcodeProduct {
  barcode      String   @id // GTIN/UPC/EAN digits
  name         String
  brand        String?
  servingSizeG Float?
  servingLabel String?
  nutrients    Json     @default("{}") // per serving: calories, proteinG, ...
  ingredients  String? // raw ingredient list text
  allergens    Json     @default("[]")
  source       String   @default("catalog") // catalog|off|user|import
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model BarcodeFavorite {
  id        String   @id @default(uuid())
  userId    String
  barcode   String
  createdAt DateTime @default(now())

  @@unique([userId, barcode])
  @@index([userId])
}

model ProductCorrection {
  id        String   @id @default(uuid())
  userId    String
  barcode   String
  field     String // name|brand|servingSizeG|ingredients|nutrients
  oldValue  String?
  newValue  String
  createdAt DateTime @default(now())

  @@index([barcode])
  @@index([userId])
}

// V2 "Today's Progress" — deterministic daily goal progress, versioned and
// idempotent. Separate from the legacy HealthScore snapshots (V1 preserved).
model UserStreakPreferences {
  id          String    @id @default(uuid())
  userId      String    @unique
  pausedUntil DateTime? // user-controlled pause (illness/travel) — no guilt mechanics
  pauseDays   String[]  @default([]) // explicit local days excluded from streak evaluation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model DailyProgressDay {
  id          String   @id @default(uuid())
  userId      String
  dayKey      String // YYYY-MM-DD in effective timezone
  timezone    String // IANA zone used for the day boundary
  version     Int      @default(2) // calculation version
  earned      Int      @default(0) // points earned 0..100
  applicable  Int      @default(100) // points applicable after redistribution
  components  Json // per-component detail: status, earned, applicable, progress, source
  dailyTarget Int? // target assigned to THIS day — historical colors never reuse today’s target
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, dayKey])
  @@index([userId, dayKey])
}

model IngredientEvidenceProfile {
  id            String    @id @default(uuid())
  ingredientKey String // loose key into the ingredient catalog (e.g. 'cinnamon')
  displayName   String
  summary       String // basic nutritional characteristics, plain language
  claims        Json      @default("[]") // [{claim, verdict, applicability, studyType, dose, limitations, source}]
  cautions      Json      @default("[]") // [{text, appliesTo}]
  status        String    @default("DRAFT") // DRAFT|IN_REVIEW|APPROVED|ACTIVE|NEEDS_REVIEW|RETIRED
  reviewedBy    String?
  reviewedAt    DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ingredientKey, version])
  @@index([ingredientKey, status])
}

// ============================================================================
// WEARABLE-READY HEALTH PLATFORM — device-agnostic sources, devices,
// measurements, sync cursors, derived summaries. Data source ≠ originating
// device ≠ measurement ≠ derived summary.
// ============================================================================
model WearableDevice {
  id               String    @id @default(uuid())
  userId           String
  provider         String // apple_health|health_connect|humai_band|internal_sim
  manufacturer     String?
  model            String?
  deviceType       String    @default("wearable") // wearable|phone|sensor|simulated
  displayName      String?
  externalDeviceId String?
  firmwareVersion  String?
  connectionState  String    @default("connected") // connected|disconnected|revoked
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  measurements HealthMeasurement[]

  @@index([userId, provider])
}

model HealthDataSource {
  id               String    @id @default(uuid())
  userId           String
  provider         String // apple_health|health_connect|humai_band|internal_sim|manual
  connectionState  String    @default("connected") // connected|paused|revoked|error
  permissionScopes Json      @default("[]")
  lastSyncAt       DateTime?
  lastAttemptAt    DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  measurements HealthMeasurement[]
  cursors      HealthSyncCursor[]

  @@unique([userId, provider])
}

model HealthMeasurement {
  id         String            @id @default(uuid())
  userId     String
  sourceId   String?
  source     HealthDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  deviceId   String?
  device     WearableDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  provider   String
  externalId String? // provider-native record id — idempotent upsert key
  metric     String // heart_rate|resting_heart_rate|hrv_sdnn|hrv_rmssd|steps|sleep|active_energy|resting_energy|workout
  value      Float?
  unit       String // canonical unit; source unit kept in meta
  startAt    DateTime
  endAt      DateTime?
  receivedAt DateTime          @default(now())
  timezone   String?
  quality    String? // measured|estimated|low_quality
  synthetic  Boolean           @default(false) // internal simulator records — never treated as real
  meta       Json              @default("{}") // hrv statistic, provider extras, corrections

  @@index([userId, metric, startAt])
  @@index([provider, externalId])
}

model HealthSyncCursor {
  id             String           @id @default(uuid())
  sourceId       String
  source         HealthDataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  metric         String
  cursor         String? // provider-native anchor (anchor token/offset)
  lastCheckpoint DateTime?
  retryCount     Int              @default(0)
  lastError      String?
  updatedAt      DateTime         @updatedAt

  @@unique([sourceId, metric])
}

model HealthMetricSummary {
  id             String   @id @default(uuid())
  userId         String
  metric         String
  periodStart    DateTime
  periodType     String   @default("day") // day|week|month
  value          Float
  unit           String
  sourceCoverage Json     @default("{}") // providers + record counts contributing
  calcVersion    String   @default("v1")
  sufficiency    String   @default("ok") // ok|partial|insufficient
  computedAt     DateTime @default(now())

  @@unique([userId, metric, periodType, periodStart])
}

// ============================================================================
// SUPPLEMENT INTELLIGENCE PLATFORM (v2)
// Canonical ingredient/form/product identity, education content, evidence
// sources, approval-gated safety rules, and scheduled dose occurrences.
// Research content imports as UNREVIEWED_RESEARCH_DRAFT — nothing here is
// clinically validated until the review workflow publishes it.
// ============================================================================

// Canonical substance — the stable identity every catalog row, formulation,
// product, education record and safety rule refers to. No dose prescription.
model SupplementIngredient {
  id String @id @default(uuid())

  slug String @unique // e.g. "vitamin-d", "magnesium", "creatine"
  name String

  category       String?
  // Nutrient family used for cumulative-exposure checks, e.g. "vitamin-d",
  // "omega3", "magnesium". Semicolon-separated families stay in activeFamilies.
  parentFamily   String?
  activeFamilies String? // normalized semicolon list, e.g. "omega3;vitamin-a"

  // DIET_REQUIRED | NO_ELEMENT_SYNTHESIS | ENDOGENOUS | PARTIAL | ESSENTIAL_FAT
  // | PROTEIN_FOOD | NONESSENTIAL_PLANT | NONESSENTIAL_OTHER | MICROBE | BLEND | HORMONE
  productionCode String?

  // NUTRIENT_ROLE_ESTABLISHED | CONTEXT_DEPENDENT | PERFORMANCE_CONTEXT |
  // COMPOSITION | MICROBE_STRAIN | LIMITED_MIXED | INSUFFICIENT | HIGH_RISK
  evidenceClass String?

  // UNREVIEWED_RESEARCH_DRAFT | UNDER_REVIEW | APPROVED | PUBLISHED | WITHDRAWN
  researchStatus String @default("UNREVIEWED_RESEARCH_DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases            SupplementAlias[]
  forms              SupplementForm[]
  productIngredients SupplementProductIngredient[]
  supplements        Supplement[]
  education          SupplementEducation[]
  interactionRules   SupplementInteractionRule[]
  userSupplements    UserSupplement[]
}

// Standardized synonyms so search resolves "D3", "cholecalciferol",
// "the sunshine vitamin" to one identity instead of creating duplicates.
model SupplementAlias {
  id String @id @default(uuid())

  ingredientId String
  ingredient   SupplementIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  alias      String
  normalized String // lowercased, punctuation-stripped lookup form

  createdAt DateTime @default(now())

  @@unique([ingredientId, normalized])
  @@index([normalized])
}

// A specific preparation of an ingredient — vitamin D3 vs D2, magnesium
// glycinate vs citrate vs oxide, CoQ10 ubiquinol vs ubiquinone, creatine
// monohydrate vs HCl. Forms are not assumed interchangeable.
model SupplementForm {
  id String @id @default(uuid())

  ingredientId String
  ingredient   SupplementIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  slug    String  @unique // e.g. "magnesium-glycinate"
  name    String
  formKey String? // short token: "d3", "glycinate", "ubiquinol", "monohydrate"

  // Formulation-specific notes (elemental content fraction, strain, salt).
  characteristics String?

  researchStatus String @default("UNREVIEWED_RESEARCH_DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplements     Supplement[]
  userSupplements UserSupplement[]
  education       SupplementEducation[]
  products        SupplementProduct[]
}

// An actual commercial product. Verified label data only — never generic
// macros inferred from the active ingredient.
model SupplementProduct {
  id String @id @default(uuid())

  brand        String?
  name         String
  sku          String?
  barcode      String?
  manufacturer String?

  formId String?
  form   SupplementForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  servingSize Float?
  servingUnit String? // g | mg | capsule | tablet | scoop | mL | packet
  servingText String? // label text, e.g. "1 scoop (31g)"

  // Supplement Facts / Nutrition Facts as labeled (JSON), plus label warnings.
  labelFacts Json?
  warnings   String?

  dataSource         String? // where the label data came from
  verificationStatus String  @default("UNVERIFIED") // UNVERIFIED | LABEL_REVIEWED | VERIFIED | STALE
  revision           Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients     SupplementProductIngredient[]
  supplements     Supplement[]
  userSupplements UserSupplement[]

  @@index([brand, name])
}

// Composition mapping: which active ingredients a product contains and how
// much per serving. amountKnown=false means "declared present, amount not
// disclosed" — never treat an unlabeled amount as zero.
model SupplementProductIngredient {
  id String @id @default(uuid())

  productId String
  product   SupplementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   SupplementIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  amount      Float?
  unit        String?
  amountKnown Boolean @default(true)
  sortOrder   Int     @default(0)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
}

// Per-item education content. Lives at ingredient level (optionally narrowed
// to a form or legacy catalog row). Separated from product labels and user
// schedules so one reviewed text serves every product of the same substance.
model SupplementEducation {
  id String @id @default(uuid())

  ingredientId String?
  ingredient   SupplementIngredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  formId       String?
  form         SupplementForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  supplementId String?               @unique // one education record per catalog row
  supplement   Supplement?           @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  overview                String?
  whatItIs                String?
  physiologicalRole       String?
  isEssentialNutrient     Boolean?
  bodyProduces            String? // production code
  productionExplanation   String?
  productionInsufficiency String?
  dietarySufficiency      String?
  foodSources             String?
  groupsWithNeeds         String?
  benefitEvidence         String?
  evidenceLimitations     String?
  timingCode              String?
  timingSuggestion        String?
  timingRationale         String?
  timingStrength          String?
  relativeAnchor          String?
  labelExceptions         String?
  adverseEffects          String?
  interactionCautions     String?
  pregnancyCaution        String?
  ageCaution              String?
  regulatoryNotes         String?
  evidenceClass           String?
  evidenceMeaning         String?

  // DRAFT -> UNDER_REVIEW -> APPROVED -> PUBLISHED -> SUPERSEDED | WITHDRAWN
  reviewStatus       String    @default("DRAFT")
  reviewedBy         String?
  reviewedAt         DateTime?
  contentVersion     Int       @default(1)
  lastEvidenceUpdate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources SupplementEducationSource[]

  @@index([ingredientId])
  @@index([reviewStatus])
}

// Claim-scoped references. A CATEGORY_INDEX source is a discovery pointer, not
// per-item verification — `supportsClaims` lists exactly what it backs.
model SupplementEducationSource {
  id String @id @default(uuid())

  educationId String
  education   SupplementEducation @relation(fields: [educationId], references: [id], onDelete: Cascade)

  sourceKey String? // dataset source id, e.g. "ODS-D"
  title     String?
  url       String

  // INGREDIENT_SPECIFIC | CATEGORY_REVIEW | CATEGORY_INDEX | GENERAL_POLICY
  scope        String?
  itemSpecific Boolean @default(false)

  publishedOn DateTime?
  accessedOn  DateTime?
  checkedOn   DateTime?

  // Which claim keys this source substantiates (JSON array). Empty when the
  // citation is category-level only — it must not be presented as verifying
  // item-specific benefit/safety claims.
  supportsClaims Json?
  reviewerStatus String?

  createdAt DateTime @default(now())

  @@index([educationId])
  @@index([sourceKey])
}

// Versioned, approval-gated safety rules — the 47 dataset drafts import with
// approved=false and stay inert until a reviewer publishes them. An absent
// rule is never evidence of safety.
model SupplementInteractionRule {
  id String @id @default(uuid())

  // Family key used by the dataset, e.g. "vitamin-d", "omega3".
  ingredientSlug String
  ingredientId   String?
  ingredient     SupplementIngredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  // MEDICATION | CONDITION | DOSE_TOTAL | LIFE_STAGE | OTHER_SUPPLEMENT |
  // PRODUCT_COMPOSITION | LIFESTYLE | FOOD | LAB_TEST | ALLERGY |
  // ADMINISTRATION | AGE_GROUP | PRODUCT_QUALITY
  triggerType  String
  triggerValue String

  consumerWarning String
  severity        String // INFO | LOW | MODERATE | HIGH | CRITICAL

  // REFER_CLINICIAN | TOTAL_EXPOSURE_CHECK | NO_AUTO_RECOMMEND |
  // REQUIRE_PRODUCT_LABEL | LABEL_SEPARATION | SEPARATION_CHECK |
  // SEPARATION_REVIEW | MEAL_CONTEXT_WARNING | LAB_DISCLOSURE_WARNING |
  // REQUIRE_ADMIN_INSTRUCTIONS
  ruleAction              String
  minSeparationHours      Float?
  populationApplicability String?

  sourceUrl        String?
  sourceId         String?
  evidenceStrength String?

  approved                Boolean @default(false)
  requiresReviewerSignoff Boolean @default(true)
  qualification           String?

  // DRAFT | UNDER_REVIEW | APPROVED | PUBLISHED | WITHDRAWN
  reviewStatus  String    @default("DRAFT")
  reviewedBy    String?
  reviewedAt    DateTime?
  version       Int       @default(1)
  effectiveDate DateTime?

  // Stable idempotency key: slug|triggerType|triggerValue|row-index.
  dedupeKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ingredientSlug])
  @@index([approved, reviewStatus])
}

// Review-workflow audit trail: one row per status transition on education,
// interaction rules, ingredients or products.
model SupplementEvidenceReview {
  id String @id @default(uuid())

  entityType String // education | interaction_rule | ingredient | product
  entityId   String

  fromStatus   String?
  toStatus     String
  reviewerId   String?
  reviewerRole String?
  notes        String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

// One concrete scheduled dose — generated from a SupplementSchedule. The
// dedupeKey (userId|scheduleId|localDate|slot) makes generation idempotent
// across ticks, syncs and timezone reconciliations.
model SupplementDoseOccurrence {
  id String @id @default(uuid())

  userId String

  scheduleId String?
  schedule   SupplementSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  userSupplementId String
  userSupplement   UserSupplement @relation(fields: [userSupplementId], references: [id], onDelete: Cascade)

  localDate    String // YYYY-MM-DD in the effective timezone
  localTime    String? // HH:MM planned wall-clock
  timezone     String? // IANA zone the slot was computed under
  scheduledFor DateTime? // UTC instant when known (fixed/fallback times)

  // PENDING | TAKEN | SKIPPED | MISSED | SNOOZED | CANCELLED
  status String @default("PENDING")

  doseAmount Float?
  doseUnit   String?

  takenLogId  String?
  snoozeUntil DateTime?
  actedAt     DateTime?

  dedupeKey      String  @unique
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs SupplementLog[]

  @@index([userId, localDate])
  @@index([status, scheduledFor])
}

model ScorePolicyVersion {
  id        String   @id @default(uuid())
  version   String   @unique
  caps      Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DailyScoreSnapshot {
  id         String   @id @default(uuid())
  userId     String
  date       DateTime @db.Date
  version    String
  composite  Float?
  state      String
  components Json
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date, version])
  @@index([userId, date])
}

model GoalHistory {
  id              String    @id @default(uuid())
  userId          String
  goal            String
  targetsSnapshot Json?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, endedAt])
}

model ScenarioDefinition {
  id           String   @id
  category     String
  priority     String
  expected     String
  data         Json?
  reviewStatus String   @default("pending_review")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// ACTIVITY SAFETY — health-aware activity recommendations (Phase 3)
// Structured safety profile: injuries, surgeries, restrictions, symptoms,
// mobility/medication flags. Unknown status is stored as unknown (null),
// never as false. All clinical rules ship DRAFT until clinician review —
// the ActivitySafetyRule_check constraint forbids silent approval.
// ============================================================================

// Mobility, accessibility, reproductive and medication-activity context.
// Coarse opt-in flags only — never an inferred medication list, never an
// inferred pregnancy status.
model UserActivityProfile {
  id     String @id @default(uuid())
  userId String @unique

  // Mobility & accessibility (I/E)
  walkingAbility       String? // 'full' | 'limited' | 'unable' | null=unknown
  mobilityAids         Json    @default("[]") // e.g. ["cane","walker","orthotic","prosthetic"]
  wheelchairUser       Boolean @default(false)
  balanceLimitation    Boolean @default(false)
  standingToleranceMin Int?
  accessibilityNeeds   Json    @default("{}")
  preferredAdaptations Json    @default("[]")

  // Reproductive health — voluntary only, never inferred (III.G)
  pregnancyStatus String? // 'pregnant' | 'postpartum' | 'none' | 'declined' | null=unknown
  postpartumWeeks Int?

  // Medication-activity flags — coarse opt-in classes only (III.F):
  // heat_sensitivity | dehydration_risk | hypoglycemia_risk |
  // heart_rate_interpretation | balance_sedation
  medicationActivityFlags Json @default("[]")

  // Personal fitness (III.H)
  fitnessExperience    String? // 'beginner' | 'intermediate' | 'advanced'
  activityPreferences  Json    @default("[]")
  desiredIntensity     String? // 'light' | 'moderate' | 'vigorous'

  // Provenance & consent per section (III.I):
  //   { mobility: {scope, consentedAt}, pregnancy: {...}, medication: {...} }
  consentScopes Json @default("{}")
  //   { field: {source, collectedAt, lastConfirmedAt, confidence} }
  provenance Json @default("{}")

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Injuries — an injury is not automatically a permanent restriction; status
// transitions are explicit. A clinician-documented restriction stays active
// until resolved/expired even if the user reports feeling better.
model UserInjury {
  id     String @id @default(uuid())
  userId String

  type       String // 'sprain'|'fracture'|'strain'|'tendinopathy'|'dislocation'|'contusion'|'post_surgical'|'undiagnosed_pain'|'other'
  bodyPart   String // normalized region key: ankle|knee|hip|lower_back|shoulder|wrist|foot|achilles|neck|hand|elbow|leg|arm|pelvis
  laterality String @default("na") // 'left'|'right'|'bilateral'|'na'
  status     String @default("current") // 'current'|'recovering'|'resolved'
  injuredAt  DateTime?
  painLevel  Int? // self-reported 0-10

  weightBearingRestriction String? // 'non_weight_bearing'|'partial'|'as_tolerated'|'full'
  rangeOfMotionRestriction String?
  prohibitedCategories     Json     @default("[]") // activity category keys — see ACTIVITY_CATEGORIES
  rehabInstructions        String?
  expectedReassessmentAt   DateTime?
  clearanceRecordedAt      DateTime? // clinician clearance *recorded* — never inferred
  clearanceNote            String?

  source       String  @default("self_reported") // 'self_reported'|'clinician_documented'|'voice'|'feedback'
  sourceDetail Json    @default("{}")
  resolvedAt   DateTime?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([bodyPart])
}

// Surgery — never infer clearance from elapsed time; restrictions and
// per-activity clearance are recorded explicitly.
model UserSurgery {
  id     String @id @default(uuid())
  userId String

  procedureCategory String // 'orthopedic'|'cardiac'|'abdominal'|'cesarean'|'other'
  procedureDetail   String?
  performedAt       DateTime?
  recoveryStage     String? // clinician-documented stage, free text key

  clinicianRestrictions Json @default("[]") // activity category keys
  activityClearance     Json @default("{}") // {activityKey: 'cleared'|'restricted'|'unknown'}
  reassessAt            DateTime?

  status          String   @default("recovering") // 'recovering'|'cleared'|'long_term_restricted'
  source          String   @default("self_reported")
  relatedInjuryId String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Documented activity restrictions — clinician-documented or self-reported.
// `status` lifecycle is explicit; nothing auto-clears on 'feeling better'.
model UserActivityRestriction {
  id     String @id @default(uuid())
  userId String

  categories  Json @default("[]") // activity category keys (see engine ACTIVITY_CATEGORIES)
  bodyRegions Json @default("[]")
  severity    String @default("prohibited") // 'prohibited' | 'modify'
  reason      String?

  source        String    @default("self_reported") // 'self_reported'|'clinician_documented'|'product_feedback'
  clinicianNote String?
  documentedAt  DateTime?

  status     String    @default("active") // 'active'|'expired'|'resolved'|'superseded'
  expiresAt  DateTime?
  reassessAt DateTime?
  resolvedAt DateTime?
  resolvedBy String?

  relatedInjuryId  String?
  relatedSurgeryId String?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Structured symptom reports — screening aid, not a diagnostic instrument.
model UserSymptomReport {
  id     String @id @default(uuid())
  userId String

  // codes: chest_pain|chest_pressure|dizziness|syncope|dyspnea_unusual|
  // palpitations|severe_pain|joint_instability|fever|abnormal_weakness|
  // pregnancy_bleeding|pregnancy_contractions|pregnancy_fluid_leak|
  // pregnancy_calf_pain|vision_changes|severe_headache|numbness|hypoglycemia
  symptoms    Json   @default("[]")
  severity    String? // 'mild'|'moderate'|'severe'
  context     String? // 'at_rest'|'during_activity'|'after_activity'|'unspecified'
  persistence String? // 'resolving'|'persistent'|'worsening'
  status      String  @default("active") // 'active'|'resolved'|'expired'
  source      String  @default("manual") // 'manual'|'voice'|'check_in'

  reportedAt    DateTime @default(now())
  resolvedAt    DateTime?
  triageOutcome String? // engine disposition recorded at report time

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, status, reportedAt])
}

// Activity safety rules — mirrors the ConditionRule gating contract:
// APPROVED requires reviewedBy + reviewedAt + evidenceSourceId (enforced by
// ActivitySafetyRule_check); consumers filter reviewStatus='APPROVED' at the
// query level so unreviewed rules can never fire for real users.
model ActivitySafetyRule {
  id       String @id @default(uuid())
  ruleCode String @unique // 'AS-MSK-001' — matches evidence register §B

  name        String
  category    String // 'core'|'musculoskeletal'|'cardiovascular'|'respiratory'|'metabolic'|'pregnancy'|'neurological'|'systemic'|'recovery'|'older_adults'|'environmental'|'personalization'
  description String?

  // Matching criteria, evaluated deterministically by the engine:
  //   appliesTo: {symptomCodes:[], injuryTypes:[], bodyParts:[],
  //               restrictionCategories:[], conditionKeys:[],
  //               profileFlags:[], envHazards:[], activityCategories:[]}
  //   exclusion: same shape — negated match
  appliesTo    Json   @default("{}")
  exclusion    Json   @default("{}")
  requiredData Json   @default("[]")
  severity     String @default("info") // 'info'|'caution'|'high'

  effect     String // ALLOW|MODIFY|DEFER_OUTDOOR|BLOCK_ACTIVITY|NEEDS_CLINICAL_REVIEW|URGENT_ESCALATION|INSUFFICIENT_DATA
  reason     String?
  actionHint String?
  // 'conservative' = treat missing material data as worst-case;
  // 'insufficient' = yield INSUFFICIENT_DATA; 'skip' = rule inert on missing
  missingDataBehavior String @default("conservative")

  evidenceSourceId String?        @db.Uuid
  evidence         RuleEvidence?  @relation(fields: [evidenceSourceId], references: [id], onDelete: Restrict)
  evidenceRef      String? // register source ID, e.g. 'ACOG_804'
  evidenceClass    String // 'established_contraindication'|'condition_precaution'|'supported_adaptation'|'product_default'|'hypothesis'

  // 'supported' = required inputs can be collected accurately; 'unsupported_input'
  // = the product has no validated signal for a required token — the rule stays
  // inactive rather than inferring from unavailable data.
  inputStatus String @default("supported")

  reviewStatus ClinicalRuleReview @default(DRAFT)
  version      Int                @default(1)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewDueAt  DateTime?

  activeAt    DateTime?
  activatedBy String?
  retiredAt   DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewStatus, category])
}

// Decision provenance — enough to explain why a recommendation was made or
// suppressed. Minimizes raw medical detail: rule IDs + dimensions, not notes.
model ActivitySafetyEvaluation {
  id     String @id @default(uuid())
  userId String

  activityId   String
  decision     String
  dimensions   Json @default("{}") // {medical, functional, environmental, personalization}
  ruleIds      Json @default("[]")
  reasons      Json @default("[]")
  restrictions Json @default("[]")
  requiredData Json @default("[]")
  alternatives Json @default("[]")

  policyVersion    String
  environmentObsId String?
  shadow           Boolean @default(false)

  expiresAt DateTime?

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Normalized weather/environment snapshot — every measurement carries
// freshness + quality so missing data is never mistaken for "safe".
model EnvironmentalObservation {
  id        String   @id @default(uuid())
  provider  String   @default("open-meteo")
  latitude  Float
  longitude Float

  observedAt    DateTime
  fetchedAt     DateTime @default(now())
  payload       Json     @default("{}") // normalized: temp/apparent/humidity/precip/wind/gusts/uv/aqi/pollutants/codes/alerts/forecast[]
  qualityStatus String   @default("ok") // 'ok'|'partial'|'stale'|'unavailable'
  expiresAt     DateTime

  @@index([latitude, longitude, observedAt])
}

// Recommendation feedback (Phase 9) — can update preferences, create a
// documented restriction, or trigger reevaluation. A one-time preference
// never becomes a permanent medical contraindication automatically.
model ActivitySafetyFeedback {
  id     String @id @default(uuid())
  userId String

  evaluationId    String?
  activityId      String?
  verdict         String // 'not_comfortable'|'causes_pain'|'have_injury'|'clinician_advised_against'|'want_rest'|'suggest_else'
  detail          String?
  resultingAction String? // 'restriction_created'|'preference_updated'|'reeval_requested'|'symptom_prompt'|'none'

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// HEALTH OUTCOMES P0 — condition persistence, medications, clinical
// measurements, rule governance (HO-IMPL-2026-11-22; additive only)
// ============================================================================

// Medication catalog-lite: deterministic identity rows only. RxNorm identifiers
// are stored when known — never invented; unmatched names stay name-only and
// are NOT treated as interchangeable with similarly named entries.
model Medication {
  id             String  @id @default(uuid())
  name           String  // display name as curated/entered
  normalizedName String  @unique // lowercase trimmed match key
  rxcui          String? // RxNorm CUI when verified — nullable, never guessed
  medicationClass String? // e.g. 'insulin','sulfonylurea','ace_inhibitor' — coarse safety class only
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userMedications UserMedication[]
}

// A user's medication entry — recommendation-safety input, NOT a prescription
// record. `active=false` rows stop influencing safety context immediately.
model UserMedication {
  id     String @id @default(uuid())
  userId String

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  // Free-text name when no catalog match — preserved verbatim; never mapped to
  // a different drug without explicit user/admin action.
  nameText  String
  doseText  String? // user-entered, verbatim ("one pill in the morning")
  doseValue Float?
  doseUnit  String?
  schedule  Json?   // optional {times:[], frequency} — informational only

  medicationClass String? // snapshot of catalog class at save time (auditable)

  startDate       DateTime?
  endDate         DateTime?
  active          Boolean  @default(true)
  source          String   @default("user_entry") // user_entry|clinician_entered|imported
  lastConfirmedAt DateTime?
  consentedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@index([medicationId])
}

// Clinical/lab measurement — distinct from HealthMeasurement (wearables):
// supports structured values (BP dual), provenance, verification, corrections.
// Never used alone to diagnose; disease-specific interpretation requires
// clinician confirmation (documented in route-level policy).
model ClinicalMeasurement {
  id     String @id @default(uuid())
  userId String

  metric String // hba1c|fasting_glucose|ldl|hdl|triglycerides|total_cholesterol|
                // bp_systolic|bp_diastolic|waist_cm|egfr|alt|ast|uric_acid|tsh|
                // creatinine|phq9|gad7|isi|psqi|weight_kg (labs/clinical only —
                // wearable metrics stay in HealthMeasurement)
  value          Float?
  valueSecondary Float? // diastolic for BP pairs; otherwise unused
  unit           String // stored as entered; normalized value in meta.normalized

  measuredAt DateTime
  source     String @default("user_entry") // user_entry|device|lab_report|clinician
  method     String? // home_cuff|lab_draw|self_report|clinical_exam
  quality    String @default("unverified") // unverified|self_reported|device_measured|lab_confirmed|clinician_verified
  // Correction chain: a corrected row supersedes correctionOfId; history kept.
  correctionOfId String?

  verifiedAt DateTime?
  verifiedBy String?   // clinician reviewer id — never self-set by client

  meta Json @default("{}") // {refRange,labName,method detail,originalUnit,normalized}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, metric, measuredAt])
}

// Clinical rule governance audit — every lifecycle transition is recorded.
// Separate from operational AuditLog: clinical provenance must survive audit
// retention windows and is exportable for regulatory review.
model ClinicalRuleEvent {
  id String @id @default(uuid())

  ruleTable String // 'ConditionRule'|'HealthConditionNutrientRule'|'ActivitySafetyRule'
  ruleId    String
  ruleCode  String?

  fromStatus String
  toStatus   String // mirrors ClinicalRuleReview + 'ACTIVATED'|'RETIRED' events
  action     String // submit|review|approve|reject|activate|retire|supersede|expire

  actorId    String
  actorRole  String? // reviewer qualification/role snapshot — NOT self-declared authority
  notes      String?
  diff       Json?   // field-level change summary

  createdAt DateTime @default(now())

  @@index([ruleTable, ruleId])
  @@index([actorId])
}

// Patient-level clinical escalation queue — user recommendations that need
// clinician input (PERSONALIZATION_REQUIRED outcomes, disease-specific
// interpretation requests). Rule-level review stays on ClinicalRuleEvent.
model UserClinicalReview {
  id     String @id @default(uuid())
  userId String

  reason  String // e.g. 'personalization_required','measurement_interpretation','conflicting_conditions'
  status  String @default("open") // open|in_review|resolved|dismissed
  context Json    @default("{}") // rule ids, condition ids, measurement ids — no free-text PHI beyond need

  requestedAt  DateTime @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?
  resolution   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
