// ============================================================================
// SMART REMINDERS & HABIT ENGINE
// ============================================================================

// Per-user reminder preferences. Everything defaults to OFF — reminders are
// strictly opt-in per the product requirement that no automatic reminders
// fire without explicit consent. `adaptiveEnabled` is a separate consent from
// `masterEnabled`: receiving notifications never implies learning consent.
model ReminderPreference {
  id     String @id @default(uuid())
  userId String @unique

  masterEnabled    Boolean @default(false)
  adaptiveEnabled  Boolean @default(false)
  // When true, no further adaptive suggestions are offered (declined permanently).
  suggestionsMuted Boolean @default(false)

  // Local wall-clock "HH:MM" bounds; wraps midnight (e.g. 22:00 -> 07:00).
  quietStart String?
  quietEnd   String?

  // Max nonessential reminder sends per local day.
  dailyCap Int @default(3)

  snoozeMinutes Int       @default(30)
  pausedUntil   DateTime?
  pauseReason   String? // vacation | rest_day | unwell | custom
  weeklyDigest  Boolean   @default(false)

  // IANA timezone used for scheduling. When timezoneLocked is set, learned/manual
  // home-time schedules are followed instead of the current local zone.
  timezone       String?
  timezoneLocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories ReminderCategorySetting[]
}

// Per-user per-category schedule. `category` is a string like
// "meal:breakfast", "meal:lunch", "water", "supplement", "workout", "movement".
// `source` records whether the schedule is user-configured ("manual") or came
// from an accepted adaptive suggestion ("adaptive"); manual always wins.
model ReminderCategorySetting {
  id String @id @default(uuid())

  userId     String
  preference ReminderPreference @relation(fields: [userId], references: [userId], onDelete: Cascade)
  category   String

  enabled Boolean @default(false)

  // ["HH:MM"] local times for fixed schedules (meals, supplements, workouts).
  times      Json  @default("[]")
  // [0-6] days the schedule applies; null = every day.
  daysOfWeek Json?

  // water: minutes since last water log (default 120)
  // movement: inactivity window 60-120
  intervalMinutes Int?
  // workout prep lead (15/30/60) or meal grace delay after typical time.
  leadMinutes     Int?
  // water waking hours override ("HH:MM"), falls back to quiet hours.
  wakingStart     String?
  wakingEnd       String?

  // Opt-in habit stacking: fire only after a confirmed event, e.g.
  // "meal:breakfast" (a FoodLog was written) or "workout:completed".
  triggerEvent String?
  triggerDelay Int? // minutes after the confirmed event

  source String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// Adaptive schedule proposal. Created only after enough comparable
// observations (>=3) and only when adaptiveEnabled. Never activates itself;
// expires stale so users aren't reprompted forever.
model ReminderSuggestion {
  id String @id @default(uuid())

  userId   String
  category String

  title    String
  body     String // "why" explanation citing the evidence
  proposed Json // { times?: ["HH:MM"], intervalMinutes?, daysOfWeek? }
  evidence Json // { observations, dates:[YYYY-MM-DD], typicalTime }

  status     String    @default("pending") // pending | accepted | declined | expired
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
}

// One concrete reminder occurrence. dedupeKey makes scheduling idempotent
// across ticks and devices: userId|category|localDate|slot. Status is the
// audit trail for the notification history/inbox.
model ReminderInstance {
  id String @id @default(uuid())

  userId   String
  category String

  dedupeKey    String   @unique
  scheduledFor DateTime

  // pending -> ready -> sent | suppressed | snoozed | completed | dismissed | skipped | expired
  status  String  @default("pending")
  reason  String?
  why     String? // short "why did I receive this" explanation
  payload Json?

  snoozeUntil DateTime?
  actedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, scheduledFor])
}

// Registered devices for remote delivery in a later milestone.
model PushDevice {
  id String @id @default(uuid())

  userId        String
  deviceId      String
  expoPushToken String?
  platform      String

  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

// Imported active-energy records from wearables (Fitbit / HealthKit / Health
// Connect). Informational only — never added to TDEE-derived targets.
model HealthEnergyRecord {
  id          String   @id @default(cuid())
  userId      String
  provider    String // 'fitbit' | 'healthkit' | 'health_connect'
  sourceId    String // provider-assigned record id (dedupe key)
  deviceLabel String?
  startAt     DateTime
  endAt       DateTime
  activeKcal  Float // active (not total) energy, kcal
  restingKcal Float? // resting/basal energy reported by the provider for this interval, kcal
  syncedAt    DateTime @default(now())
  metadata    Json? // original provider fields
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, sourceId])
  @@index([userId, startAt])
}

// User-owned workout plan versions (drafts require explicit confirmation).
model UserWorkoutPlan {
  id          String    @id @default(cuid())
  userId      String
  version     Int       @default(1)
  status      String    @default("draft")
  preferences Json?
  plan        Json
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Imported exercise library (free-exercise-db and future licensed sources).
model Exercise {
  id             String           @id
  name           String
  normalizedName String           @unique
  level          String?
  force          String?
  mechanic       String?
  equipment      String?
  appEquipment   String[]
  category       String?
  instructions   String[]
  source         String           @default("free-exercise-db")
  sourceId       String?
  reviewStatus   String           @default("imported")
  muscles        ExerciseMuscle[]

  @@index([normalizedName])
  @@index([appEquipment])
}

model ExerciseMuscle {
  id         String @id @default(uuid())
  exerciseId String
  muscle     String
  role       String // 'primary' | 'secondary'

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscle, role])
  @@index([muscle, role])
}

// Voice command audit + undo. Stores parsed actions and the entities they
// created so undo can reverse them within a bounded window. No audio stored.
model VoiceCommand {
  id              String    @id
  userId          String
  transcript      String
  actions         Json
  createdEntities Json // [{kind:'water'|'foodLog'|'supplementLog'|'workoutSession'|'exerciseSetUpdate'|'workoutSessionComplete', id, prev?}]
  result          Json?
  undoneAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
}

// ============================================================================
// TRAINER PLATFORM — APPLICATIONS, CERTIFICATIONS, CONSENT
// ============================================================================

model TrainerCertification {
  id                  String         @id @default(uuid())
  trainerId           String
  trainer             TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String?
  credentialId        String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  verificationStatus  String         @default("unverified") // unverified | pending_review | verified | rejected | legacy
  verifiedAt          DateTime?
  verifiedBy          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([trainerId])
}

model TrainerClientConsent {
  id            String        @id @default(uuid())
  relationId    String
  relation      TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  category      String // workout_records | food_logs | nutrition_summaries | weight_trends | sleep_summaries | step_counts | body_measurements
  status        String        @default("pending") // pending | granted | revoked
  policyVersion String        @default("v1") // "v0-legacy" for backfilled relations
  grantedAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([relationId, category])
  @@index([relationId])
}

// ============================================================================
// TRAINER NUTRITION GUIDANCE
// ============================================================================

model TrainerNutritionPlan {
  id           String         @id @default(uuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId     String?
  title        String
  guidanceText String?
  status       String         @default("draft") // draft | published | archived
  version      Int            @default(1)
  supersedesId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  meals       TrainerNutritionPlanMeal[]
  targets     TrainerNutritionTargets?
  assignments TrainerNutritionAssignment[]

  @@index([trainerId])
  @@index([clientId])
}

model TrainerNutritionPlanMeal {
  id       String               @id @default(uuid())
  planId   String
  plan     TrainerNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mealType String // breakfast | lunch | dinner | snack
  timing   String?
  notes    String?

  items TrainerNutritionPlanItem[]

  @@index([planId])
}

model TrainerNutritionPlanItem {
  id            String                   @id @default(uuid())
  mealId        String
  meal          TrainerNutritionPlanMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredientId  String?
  recipeId      String?
  foodName      String?
  quantityG     Float
  substitutions Json?

  @@index([mealId])
}

model TrainerNutritionTargets {
  id           String               @id @default(uuid())
  planId       String               @unique
  plan         TrainerNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  caloriesKcal Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  fiberG       Float?
  waterMl      Float?
}

model TrainerNutritionAssignment {
  id          String               @id @default(uuid())
  planId      String
  plan        TrainerNutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  clientId    String
  status      String               @default("assigned") // assigned | accepted | declined | archived
  assignedAt  DateTime             @default(now())
  respondedAt DateTime?

  feedback TrainerNutritionFeedback[]

  @@index([planId])
  @@index([clientId])
}

model TrainerNutritionFeedback {
  id           String                     @id @default(uuid())
  assignmentId String
  assignment   TrainerNutritionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  clientId     String
  rating       Int?
  note         String?
  createdAt    DateTime                   @default(now())

  @@index([assignmentId])
}

// ============================================================================
// TRAINER-CLIENT MESSAGING & PUSH
// ============================================================================

model Conversation {
  id         String        @id @default(uuid())
  relationId String        @unique
  relation   TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages Message[]

  @@index([relationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, id])
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================================
// TRAINER SCHEDULING
// ============================================================================

model TrainerAvailability {
  id            String         @id @default(uuid())
  trainerId     String
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  weekday       Int // 0=Sun..6=Sat
  startMin      Int // minutes from midnight, trainer tz
  endMin        Int
  timeZone      String // IANA id
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?

  @@index([trainerId])
}

model TrainerSessionType {
  id              String         @id @default(uuid())
  trainerId       String
  trainer         TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name            String
  durationMin     Int
  mode            String         @default("virtual") // virtual | in_person
  meetingLink     String?
  bufferMin       Int            @default(0)
  minNoticeMin    Int            @default(1440)
  cancelWindowMin Int            @default(1440)
  active          Boolean        @default(true)

  bookings TrainerBooking[]

  @@index([trainerId])
}

model TrainerSchedulingPreference {
  id        String         @id @default(uuid())
  trainerId String         @unique
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  timeZone  String         @default("UTC") // IANA id
}

model TrainerBooking {
  id            String             @id @default(uuid())
  relationId    String
  relation      TrainerClient      @relation(fields: [relationId], references: [id], onDelete: Cascade)
  sessionTypeId String
  sessionType   TrainerSessionType @relation(fields: [sessionTypeId], references: [id])
  startAtUtc    DateTime
  endAtUtc      DateTime
  status        String             @default("requested") // requested | confirmed | declined | canceled | completed | rescheduled
  requestedBy   String // client | trainer
  meetingLink   String?
  clientNote    String?
  trainerNote   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  events TrainerBookingEvent[]

  @@index([relationId])
  @@index([sessionTypeId, startAtUtc])
}

model TrainerBookingEvent {
  id        String         @id @default(uuid())
  bookingId String
  booking   TrainerBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   String
  action    String // requested | confirmed | declined | canceled | rescheduled | completed
  fromStart DateTime?
  toStart   DateTime?
  createdAt DateTime       @default(now())

  @@index([bookingId])
}

// ============================================================================
// TRAINER PAID COACHING (schema + mock provider only — live payments disabled)
// ============================================================================

model TrainerCoachingPackage {
  id           String         @id @default(uuid())
  trainerId    String
  trainer      TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title        String
  kind         String // subscription | one_time | session_pack
  sessionCount Int?
  interval     String? // month | year for subscriptions
  priceCents   Int
  currency     String         @default("usd")
  active       Boolean        @default(true)

  purchases TrainerPurchase[]

  @@index([trainerId])
}

model TrainerPurchase {
  id          String                 @id @default(uuid())
  clientId    String
  packageId   String
  package     TrainerCoachingPackage @relation(fields: [packageId], references: [id])
  provider    String                 @default("mock")
  providerRef String                 @unique
  status      String                 @default("pending") // pending | paid | failed | refunded | canceled
  amountCents Int
  currency    String                 @default("usd")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  subscription TrainerSubscription?
  transactions TrainerPaymentTransaction[]
  refunds      TrainerRefund[]
  entitlements TrainerEntitlement[]

  @@index([clientId])
}

model TrainerSubscription {
  id               String          @id @default(uuid())
  purchaseId       String          @unique
  purchase         TrainerPurchase @relation(fields: [purchaseId], references: [id])
  status           String          @default("active") // active | canceled | expired | past_due
  currentPeriodEnd DateTime?
  cancelAt         DateTime?
}

model TrainerEntitlement {
  id                String           @id @default(uuid())
  purchaseId        String?
  purchase          TrainerPurchase? @relation(fields: [purchaseId], references: [id])
  clientId          String
  trainerId         String
  kind              String // subscription | session_pack | session
  remainingSessions Int?
  expiresAt         DateTime?
  status            String           @default("active") // active | exhausted | expired | revoked

  @@index([clientId, status])
  @@index([trainerId])
}

model TrainerPaymentTransaction {
  id              String          @id @default(uuid())
  purchaseId      String
  purchase        TrainerPurchase @relation(fields: [purchaseId], references: [id])
  provider        String
  providerEventId String          @unique // webhook idempotency
  type            String // checkout | payment | refund | payout | subscription_update
  payload         Json?
  createdAt       DateTime        @default(now())

  @@index([purchaseId])
}

model TrainerPayout {
  id          String         @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id])
  amountCents Int
  currency    String         @default("usd")
  status      String         @default("pending") // pending | processing | paid | failed
  providerRef String?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime       @default(now())

  @@index([trainerId])
}

model TrainerRefund {
  id          String          @id @default(uuid())
  purchaseId  String
  purchase    TrainerPurchase @relation(fields: [purchaseId], references: [id])
  amountCents Int
  reason      String?
  status      String          @default("pending") // pending | processed | failed
  createdAt   DateTime        @default(now())
}

model TrainerPromotion {
  id             String    @id @default(uuid())
  code           String    @unique
  percentOff     Int?
  amountOffCents Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

// ============================================================================
// COACHING CHECK-INS (member → trainer structured weekly reviews)
// ============================================================================

model CheckIn {
  id                String        @id @default(uuid())
  relationId        String
  relation          TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  clientId          String
  weekOf            DateTime // Monday (UTC) the check-in covers
  goalProgress      String? // member self-assessment vs goal
  workoutDifficulty Int? // 1-5 perceived difficulty
  energyLevel       Int? // 1-5 recovery/energy
  weightKg          Float? // optional weight update
  questions         String?
  challenges        String?
  notes             String?
  reviewedAt        DateTime?
  reviewedBy        String?
  trainerReply      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([relationId, weekOf])
  @@index([clientId])
  @@index([relationId])
}

// ---------------------------------------------------------------------------
// Coaching communication platform (web) — groups, documents, video sessions.
// DM conversations reuse existing Conversation/Message models above.
// ---------------------------------------------------------------------------

model CoachingGroup {
  id         String   @id @default(uuid())
  name       String
  kind       String   @default("coaching") // coaching|cohort|challenge|nutrition
  trainerId  String
  trainer    TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  status     String   @default("active")   // active|archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    CoachingGroupMember[]
  messages   GroupMessage[]
  readCursors GroupReadCursor[]
  documentShares TrainerDocumentShare[]

  @@index([trainerId, status])
}

model CoachingGroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  role      String    @default("member")   // member|moderator|owner
  status    String    @default("invited")  // invited|active|left|removed
  invitedBy String?
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  group     CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([groupId, id])
}

model GroupReadCursor {
  groupId           String
  group             CoachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId            String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  @@id([groupId, userId])
}

model MessageReport {
  id          String   @id @default(uuid())
  messageKind String                       // dm|group
  messageId   String
  reporterId  String
  reason      String
  status      String   @default("open")    // open|resolved|dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model TrainerDocument {
  id          String   @id @default(uuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String   @default("education") // nutrition|workout|meal_plan|exercise|progress|education
  fileKey     String                       // storage-relative key (never exposed)
  fileName    String
  mimeType    String   @default("application/pdf")
  sizeBytes   Int
  version     Int      @default(1)
  status      String   @default("active")    // active|revoked
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shares      TrainerDocumentShare[]

  @@index([trainerId, status])
}

model TrainerDocumentShare {
  id         String   @id @default(uuid())
  documentId String
  document   TrainerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relationId String?  // share with one coaching relationship
  relation   TrainerClient? @relation(fields: [relationId], references: [id], onDelete: Cascade)
  groupId    String?
  group      CoachingGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([relationId])
  @@index([groupId])
}

model VideoSession {
  id                  String   @id @default(uuid())
  relationId          String
  relation            TrainerClient @relation(fields: [relationId], references: [id], onDelete: Cascade)
  roomName            String   @unique
  purpose             String?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  status              String   @default("scheduled") // scheduled|live|ended|cancelled
  recordingRequested  Boolean  @default(false)
  recordingStartedAt  DateTime?
  recordingEndedAt    DateTime?
  endedAt             DateTime?
  exerciseKey         String?  // optional exercise-demo ref from the exercise library
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  consents            RecordingConsent[]
  summary             VideoSessionSummary?

  @@index([relationId, scheduledStart])
  @@index([status])
}

model RecordingConsent {
  id             String   @id @default(uuid())
  videoSessionId String
  videoSession   VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  userId         String
  granted        Boolean
  policyVersion  String
  withdrawnAt    DateTime?
  createdAt      DateTime @default(now())

  @@unique([videoSessionId, userId])
}

model VideoSessionSummary {
  id             String   @id @default(uuid())
  videoSessionId String   @unique
  videoSession   VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  memberSummary  String?
  actionItems    Json?
  privateNotes   String?
  publishedAt    DateTime?
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// KNOWLEDGE ACADEMY — research-backed education (editorial workflow)
// ============================================================================

model ResearchSource {
  id               String   @id @default(uuid())
  key              String   @unique // doi:<doi> | pmid:<id> | url:<stable-url>
  title            String
  authors          Json?
  journal          String?
  year             Int?
  doi              String?
  pmid             String?
  url              String?
  studyType        String?  // guideline|meta_analysis|rct|cohort|review|position_stand
  population       String?
  intervention     String?
  comparator       String?
  outcomes         String?
  resultsSummary   String?
  limitations      String?
  status           String   @default("active") // active|retracted|corrected|unavailable
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  evidenceLinks    ArticleEvidence[]

  @@index([status])
}

model KnowledgeArticle {
  id                String    @id @default(uuid())
  slug              String    @unique
  category          String
  tags              Json      @default("[]")
  status            String    @default("draft") // draft|researching|ready_for_review|changes_requested|approved|scheduled|published|correction_required|retracted|archived
  authorId          String
  reviewerId        String?
  currentRevisionId String?
  approvedRevisionId String?  // immutable pointer set on approval
  publishedRevisionId String?
  publishedAt       DateTime?
  lastReviewedAt    DateTime?
  withdrawnAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  revisions  KnowledgeArticleRevision[]
  reviews    ArticleReview[]
  schedule   EditorialSchedule[]
  savedBy    KnowledgeSavedItem[]
  corrections ContentCorrection[]
  faqs       KnowledgeFAQ[]

  @@index([status, publishedAt])
  @@index([category, status])
}

model KnowledgeArticleRevision {
  id            String   @id @default(uuid())
  articleId     String
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version       Int
  title         String
  claim         String   // the myth/common claim being examined
  verdict       String   // MYTH|MOSTLY_MYTH|CONTEXT_DEPENDENT|MOSTLY_SUPPORTED|SUPPORTED|INSUFFICIENT_EVIDENCE
  shortVerdict  String   // one-sentence explanation
  explanation   String   // what the evidence suggests, plain language
  takeaway      String?  // practical takeaway
  appliesTo     String?  // who the finding applies to
  exceptions    String?  // important exceptions
  uncertainty   String?  // conflicting findings / gaps
  certainty     String   @default("NOT_ASSESSED") // HIGH|MODERATE|LOW|VERY_LOW|NOT_ASSESSED
  certaintyRationale String? // reviewer rationale — required when certainty assessed
  aiAssisted    Boolean  @default(false)
  immutable     Boolean  @default(false) // frozen at approval — scheduled/published refs point here
  createdById   String
  createdAt     DateTime @default(now())

  evidence  ArticleEvidence[]
  reviews   ArticleReview[]
  schedule  EditorialSchedule[]
  events    PublicationEvent[]
  corrections ContentCorrection[]

  @@unique([articleId, version])
  @@index([articleId])
}

model ArticleEvidence {
  id          String   @id @default(uuid())
  revisionId  String
  revision    KnowledgeArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceId    String
  source      ResearchSource @relation(fields: [sourceId], references: [id])
  supports    String?  // which claim/section it backs
  position    Int      @default(0)

  @@unique([revisionId, sourceId])
  @@index([sourceId])
}

model ArticleReview {
  id         String   @id @default(uuid())
  articleId  String
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId String
  revision   KnowledgeArticleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewerId String
  decision   String   // approved|changes_requested
  feedback   Json?    // field-specific comments
  scope      String?  // clinical|general — reviewers' declared scope for this review
  createdAt  DateTime @default(now())

  @@index([articleId, createdAt])
  @@index([reviewerId, createdAt])
}

model ReviewerProfile {
  userId        String   @id
  expertise     Json     @default("[]") // topic keys the reviewer covers
  qualifications String?  // self-declared; NOT verified credentials
  conflicts     String?  // disclosed conflicts of interest
  clinical      Boolean  @default(false) // eligible for clinical-scope reviews
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EditorialSchedule {
  id           String    @id @default(uuid())
  publishKey   String    @unique // idempotency: e.g. weekly:2026-45
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId   String
  revision     KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  scheduledFor DateTime
  status       String    @default("scheduled") // scheduled|published|cancelled|blocked|withdrawn
  blockedReason String?
  publishedAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
}

model PublicationEvent {
  id           String   @id @default(uuid())
  scheduleId   String?  @unique // one event per schedule → idempotent
  articleId    String
  revisionId   String
  revision     KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  kind         String   @default("weekly") // weekly|correction|republication
  scheduledFor DateTime
  publishedAt  DateTime @default(now())
  notifiedAt   DateTime?

  @@index([articleId, publishedAt])
}

model KnowledgeFAQ {
  id              String   @id @default(uuid())
  canonicalQuestion String @unique
  aliases         Json     @default("[]")
  shortAnswer     String
  detail          String?
  topicTags       Json     @default("[]")
  articleId       String?
  article         KnowledgeArticle? @relation(fields: [articleId], references: [id])
  sourceKeys      Json     @default("[]") // ResearchSource.key list — validated on write
  certainty       String   @default("NOT_ASSESSED")
  status          String   @default("draft") // draft|published|retired
  language        String   @default("en")
  version         Int      @default(1)
  lastReviewedAt  DateTime?
  reviewerId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model KnowledgeSavedItem {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

model KnowledgeQuestionSuggestion {
  id        String   @id @default(uuid())
  userId    String?
  question  String
  status    String   @default("open") // open|reviewed|answered|declined
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ContentCorrection {
  id           String   @id @default(uuid())
  articleId    String
  article      KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionId   String
  revision     KnowledgeArticleRevision @relation(fields: [revisionId], references: [id])
  kind         String   // retraction|guideline_change|new_evidence|error|source_unavailable
  detail       String
  status       String   @default("open") // open|corrected|withdrawn
  createdById  String
  resolvedRevisionId String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

// ============================================================================
// MODULAR MEMBERSHIPS — server-side entitlement engine
// ============================================================================

model MembershipModule {
  key         String   @id // FREE_CORE|NUTRITION|WORKOUTS|EXERCISE_LIBRARY|ADVANCED_VIDEO_GUIDANCE|LEO_AI|ADVANCED_ANALYTICS|TRAINER_COACHING|LIVE_SESSIONS|KNOWLEDGE_PREMIUM
  name        String
  description String?
  sortOrder   Int      @default(0)
}

model MembershipPackage {
  id          String   @id @default(uuid())
  key         String   @unique // free|nutrition|workout|nutrition_workout|full|ai_addon|byot|trainer_coached
  name        String
  description String?
  modules     Json     @default("[]") // MembershipModule.key list
  trialDays   Int      @default(0)
  active      Boolean  @default(false) // draft until activated
  platforms   Json     @default("[]")  // ios|android|web availability
  storeIds    Json     @default("{}")  // {appStore, playStore, web} provider product ids — set at sale time
  displayCopy Json?
  effectiveFrom DateTime?
  effectiveUntil DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserEntitlement {
  id         String    @id @default(uuid())
  userId     String
  moduleKey  String
  source     String    // purchase|trial|complimentary|admin_grant|trainer_relationship
  status     String    @default("active") // active|grace|expired|revoked
  startsAt   DateTime  @default(now())
  endsAt     DateTime? // null = no expiry (e.g. free core)
  packageKey String?
  purchaseRef String?  // provider transaction id — dedupe key with provider
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, moduleKey, status])
  @@index([status, endsAt])
}

model EntitlementEvent {
  id              String   @id @default(uuid())
  userId          String
  moduleKey       String
  packageKey      String?
  event           String   // purchase|activation|renewal|upgrade|downgrade|cancellation|expiration|refund|grant|revoke|trial_start|trial_end
  payload         Json?
  providerEventId String?  @unique // idempotent provider webhook reconciliation
  occurredAt      DateTime
  processedAt     DateTime @default(now())
  actorId         String?

  @@index([userId, occurredAt])
}

// Member's chosen coaching model (Trainer Partnership Mode).
model CoachingPreference {
  userId    String   @id
  model     String   @default("self_guided") // self_guided|humai_assisted|trainer_led|hybrid
  updatedAt DateTime @updatedAt
}

model ActionFeedback {
  id        String   @id @default(uuid())
  userId    String
  actionKey String
  verdict   String
  createdAt DateTime @default(now())

  @@index([userId, actionKey, createdAt])
}

// Gut health — member symptom journal. Never infers causality; severity 1-5.
model GutSymptom {
  id        String   @id @default(uuid())
  userId    String
  symptom   String   // bloating|gas|constipation|diarrhea|reflux|abdominal|stool_frequency
  severity  Int      @default(3)
  bristol   Int?     // optional Bristol Stool Form 1-7
  note      String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// Individualized food tolerance — DISTINCT from the Allergy model.
// kind: suspected|intolerance|dislike|exclusion (allergy lives in Allergy).
model FoodTolerance {
  id        String   @id @default(uuid())
  userId    String
  foodName  String
  kind      String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// User-selected habit coaching — no streak punishment, pause/snooze friendly.
model Habit {
  id          String   @id @default(uuid())
  userId      String
  title       String
  kind        String   @default("custom") // fiber|workout|sleep_window|meal_prep|movement_break|reflection|supplement|custom
  daysOfWeek  Int      @default(127) // bitmask Mon=1..Sun=64, 127=daily
  status      String   @default("active") // active|paused|archived
  snoozedUntil DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId, status])
}

model HabitCompletion {
  id       String   @id @default(uuid())
  habitId  String
  day      String   // YYYY-MM-DD local day
  outcome  String   @default("done") // done|skipped
  habit    Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, day])
}

// Wellness check-in — self-reported stress/mood/fatigue. Never diagnostic,
// never auto-shared with trainers.
model WellnessCheckIn {
  id        String   @id @default(uuid())
  userId    String
  stress    Int      // 1-5
  mood      Int      // 1-5
  fatigue   Int      // 1-5
  note      String?
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}
