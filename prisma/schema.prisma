generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  emailVerifiedAt DateTime?
  authActions     AuthAction[]
  passwordHash    String?
  profileData     Json?
  sessions        AuthSession[]

  firstName String?
  lastName  String?

  dateOfBirth DateTime?

  gender String?

  heightCm        Float?
  currentWeightKg Float?

  goalType      String?
  activityLevel String?

  // IANA timezone for local-day boundaries (energy summaries, streaks).
  // Optional — clients may also pass a timezone per request.
  timeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities UserIdentity[]

  healthProfile    UserHealthProfile?
  healthConditions UserHealthCondition[]
  allergies        UserAllergy[]
  weightEntries    WeightEntry[]
  dailySteps       DailySteps[]
  waterLogs        WaterLog[]
  sleepLogs        SleepLog[]
  gutSymptoms      GutSymptom[]
  foodTolerances   FoodTolerance[]
  habits           Habit[]
  wellnessCheckIns WellnessCheckIn[]
  foodLogs         FoodLog[]
  dailyScoreSnapshots DailyScoreSnapshot[]
  goalHistories      GoalHistory[]
  workoutSessions  WorkoutSession[]
  coachingSessions CoachingSession[]
  energyRecords    HealthEnergyRecord[]
  workoutPlans     UserWorkoutPlan[]
  groceryItems     GroceryItem[]
  recipeEngagements RecipeEngagement[]

  activityProfile       UserActivityProfile?
  injuries              UserInjury[]
  surgeries             UserSurgery[]
  activityRestrictions  UserActivityRestriction[]
  symptomReports        UserSymptomReport[]
  safetyEvaluations     ActivitySafetyEvaluation[]
  safetyFeedback        ActivitySafetyFeedback[]
}

model UserHealthProfile {
  id String @id @default(uuid())

  userId String @unique

  smoker        Boolean @default(false)
  drinksAlcohol Boolean @default(false)

  sleepGoalHours Float?

  waterGoalMl Int?

  notes String?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model HealthCondition {
  id String @id @default(uuid())

  name String @unique

  description String?

  // Stable machine key (e.g. 'type_2_diabetes') — the registry + engine map on
  // this, not the display name. Unique so catalog lookups can't drift.
  slug String? @unique

  // Registry grouping (metabolic|cardiovascular|digestive|musculoskeletal|
  // sleep_mental_respiratory|kidney_reproductive|allergy|life_stage|other).
  category String?

  // evidence-based | education_only | supervised_only — mirrors audit doc 03.
  evidenceClass String?

  // Patient-facing education copy; never a clinical claim.
  educationSummary String?

  // Registry metadata (staging axis, icdHint, aliases) — keeps the row lean.
  registryMeta Json?

  userConditions  UserHealthCondition[]
  conditionRules  ConditionRule[]
  supplementRules SupplementRule[]
  nutrientRules   HealthConditionNutrientRule[]
}

model UserHealthCondition {
  id String @id @default(uuid())

  userId String

  conditionId String

  severity String?

  active Boolean @default(true)

  // 'self_report' | 'clinician_reported' — a self-reported condition is never
  // treated as a confirmed diagnosis downstream.
  source String @default("self_report")

  diagnosedAt      DateTime?
  consentedAt      DateTime?
  lastConfirmedAt  DateTime?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  condition HealthCondition @relation(fields: [conditionId], references: [id])

  @@index([userId, active])
}

model Allergy {
  id String @id @default(uuid())

  name String @unique

  userAllergies UserAllergy[]
}

model UserAllergy {
  id String @id @default(uuid())

  userId String

  allergyId String

  user User @relation(fields: [userId], references: [id])

  allergy Allergy @relation(fields: [allergyId], references: [id])
}

model WeightEntry {
  id String @id @default(uuid())

  userId String

  weightKg Float

  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DailySteps {
  id String @id @default(uuid())

  userId String

  date DateTime

  steps Int

  distanceKm Float?

  // Source attribution: 'app' (manual/device sensors today), future 'fitbit',
  // 'apple-health', 'health-connect'. externalId enables provider dedup.
  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model WaterLog {
  id String @id @default(uuid())

  userId String

  amountMl Int

  loggedAt DateTime @default(now())

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model SleepLog {
  id String @id @default(uuid())

  userId String

  sleepStart DateTime

  sleepEnd DateTime

  hoursSlept Float?

  sleepScore Float?

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])
}

model FoodLog {
  ingredientId      String?
  nutritionSnapshot Json?
  micronutrients    Json?
  id                String  @id @default(uuid())

  userId String

  foodName String

  quantityG Float

  calories Float

  proteinG Float

  carbsG Float

  fatG Float

  fiberG Float?

  mealType String

  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model WorkoutSession {
  id String @id @default(uuid())

  userId String

  workoutType String

  finishedAt DateTime?

  durationMinutes Int

  caloriesBurned Float?

  startedAt DateTime

  endedAt DateTime

  source     String  @default("app")
  externalId String?

  user User @relation(fields: [userId], references: [id])

  exerciseSets ExerciseSet[]

  planAssignmentId String? // links actual logged session to a trainer assignment (never required)

  @@index([planAssignmentId])
}

model ExerciseSet {
  id String @id @default(uuid())

  workoutSessionId String

  exerciseName String

  reps Int

  weightLbs Float?

  setNumber Int

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id])
}

// Camera-coaching session — landmark-derived, consent-gated, additive.
// NEVER stores raw frames/video; only rep diagnostics, coaching events shown,
// and user-confirmed/corrected counts. Unconfirmed sessions are not workout
// records — confirmed reps may be copied into ExerciseSet by the client.
// §26/27 exercise intelligence (pc-HUM-108) — simplest versioned architecture.
// One row per (exerciseId, version); monotonic versions per exercise make
// profile versions traceable and let workout results reference the exact
// profile version in force. Ordinary users have NO write path at any layer —
// profiles are server-controlled (seed/admin), satisfying the spec's
// activation-safety rule by construction. Movement families are a canonical
// server-side registry (spec §familes are a bounded editorial set — a table
// would be redundant ceremony).
model ExerciseIntelligenceProfile {
  id             String   @id @default(uuid())
  exerciseId     String
  version        Int
  // primary family from the canonical spec registry; secondaryFamilies is a
  // JSON array for compound exercises. Equipment stays orthogonal on the
  // Exercise catalog rows per spec — never duplicated into family identity.
  movementFamily    String
  secondaryFamilies String  @default("[]")
  movementSubtype   String?
  trackingMethod    String  @default("manual") // manual | rep_counter_fsm | pose_ml | none
  coachingCapability String @default("none") // none | basic | guided | automated
  // validated capability map — e.g. {"repCounting": {"status": "validated", "engine": "rep-counter-fsm", "engineVersion": "1"}}
  // shape-validated at the service layer; unknown capabilities never activate.
  capabilities   String
  status         String   @default("draft") // draft | validated | disabled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([exerciseId, version])
  @@index([exerciseId, status])
}

model CoachingSession {
  id String @id @default(uuid())

  userId String

  exerciseId String

  startedAt DateTime
  endedAt   DateTime?

  // Build + version provenance for reproducibility/rollback decisions.
  devicePlatform String?
  appBuild       String?
  modelVersion   String? // e.g. "pose_landmarker_lite@59929e1d"
  ruleVersion    String?
  cameraView     String? // side | front | unknown

  // Camera-derived count and the user's reviewed/corrected final.
  countedReps   Int  @default(0)
  confirmedReps Int?
  discarded     Boolean @default(false)

  // Explicit consent to persist this session's analytics.
  consentToStore Boolean @default(true)

  repDiagnostics Json? // [{side,samplesUsed,minVisibilitySeen,rangeOfMotion,durationMs}]
  corrections    Json? // {adjust, final, note?}
  observations   Json? // coaching events shown [{ruleId,deviation,confidence,priority}]
  limitations    String?

  source    String   @default("camera")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, exerciseId])
  @@index([userId, startedAt])
}

model Recipe {
  nutritionSource Json?
  id              String @id @default(uuid())

  creatorId String

  recipeName String @unique

  mealType String? // breakfast | lunch | dinner | snack

  cuisine String?

  region String?

  aliases String[] @default([])

  // SYSTEM (seeded) | RESEARCH_DRAFT (imported, unverified) | VERIFIED | REJECTED
  reviewStatus String @default("SYSTEM")

  // Stable external identity for idempotent recipe imports (e.g. HUMAI-RCP-0001).
  sourceKey String? @unique

  // Measured/illustrative cooked yield of the whole batch in grams.
  finishedYieldG Float?

  prepMinutes Int?

  // Structured cooking steps: [{step,text,minutes?,safetyNote?,optionalIngredients?[]}]
  instructions Json?

  // Recipe-wide safety notes (poultry temp, egg doneness, leftovers).
  safetyNotes Json?

  // Declared major allergens present (egg, dairy, gluten, fish, shellfish,
  // soy, peanut, tree nut, sesame). Used for user allergy exclusion only —
  // absence does not prove a recipe is allergy-safe.
  allergens String[] @default([])

  description String?

  servings Int @default(1)

  calories Float?

  proteinG Float?

  carbsG Float?

  fatG Float?

  fiberG Float? @default(0)

  portionG Float?

  isSystem Boolean @default(false)

  ingredients RecipeIngredient[]

  weeklyMeals WeeklyMeal[]

  engagements RecipeEngagement[]

  createdAt DateTime @default(now())
}

model RecipeIngredient {
  ingredientId      String?
  nutritionSnapshot Json?
  id                String  @id @default(uuid())

  recipeId String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientName String

  amountG Float

  optional   Boolean @default(false)

  calories Float?

  proteinG Float?

  carbsG Float?

  fatG Float?

  // Per-line fiber snapshot (nullable — NULL = not measured, never read as 0).
  fiberG Float?

  @@index([recipeId])
}

// User shopping-list rows seeded from recipe missing ingredients or manual adds.
model GroceryItem {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String
  amountG        Float?
  unitLabel      String?
  optional       Boolean  @default(false)
  sourceRecipeId String?
  status         String   @default("pending") // pending | purchased | skipped
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
}

// Per-user recipe engagement: favorites, ratings, notes, private custom variants.
model RecipeEngagement {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  favorite     Boolean  @default(false)
  rating       Int?     // 1..5 ease-of-preparation
  notes        String?
  // Private personalized variant (ingredient amount tweaks); never promoted
  // to the shared catalog without review.
  customData   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, recipeId])
  @@index([userId, favorite])
}

model Recommendation {
  id String @id @default(uuid())

  userId String

  recommendationType String

  recommendationText String

  accepted Boolean @default(false)

  completed Boolean @default(false)

  staleAt    DateTime?
  staleReason String?

  createdAt DateTime @default(now())
}

model UserInsight {
  id String @id @default(uuid())

  userId String

  insight String

  confidence Float

  createdAt DateTime @default(now())
}

model UserEvent {
  id String @id @default(uuid())

  userId String

  eventType String

  eventData Json?

  createdAt DateTime @default(now())
}

model Supplement {
  id String @id @default(uuid())

  name String @unique

  category String?
  brand    String?
  flavor   String?

  defaultDose  String?
  servingSizeG Float?

  // Nutrition per serving (from the label).
  calories Float @default(0)
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)
  fiberG   Float @default(0)

  // Seeded defaults shown first in the catalog; user-added entries are false.
  isDefault Boolean @default(false)

  // Canonical identity links (v2 catalog). Nullable until the import pipeline
  // maps this row to a SupplementIngredient/Form/Product.
  ingredientId String?
  ingredient   SupplementIngredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  formId       String?
  form         SupplementForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  productId    String?
  product      SupplementProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  // published | candidate | review_only | personal | archived
  // review_only rows stay out of suggestions/default listings; personal rows
  // belong to ownerId and are never published to the shared catalog.
  catalogStatus String @default("published")
  reviewStatus  String @default("UNREVIEWED_RESEARCH_DRAFT")

  // Set on personal (user-created) supplements; null for shared catalog rows.
  ownerId String?

  createdAt DateTime @default(now())

  userLinks       UserSupplement[]
  attributes      SupplementAttribute[]
  supplementRules SupplementRule[]
  schedules       SupplementSchedule[]
  education       SupplementEducation?

  @@index([catalogStatus])
  @@index([ownerId])
}

// Per-user supplement selections. Users pick which supplements they take.
// Only selected supplements appear on their dashboard.
model UserSupplement {
  id String @id @default(uuid())

  userId String

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  // Optional canonical links — resolved when the selection maps to the
  // v2 catalog; null for legacy/personal selections.
  ingredientId String?
  ingredient   SupplementIngredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  formId       String?
  form         SupplementForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  productId    String?
  product      SupplementProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  // User-entered label info for personal products (never shared).
  personalLabel Json?

  // The user's own dose choice — entered from their label/clinician, never
  // auto-suggested by the system.
  doseAmount Float?
  doseUnit   String?
  notes      String?

  // When the user last marked this supplement as taken.
  lastTakenAt DateTime?

  createdAt DateTime @default(now())

  logs        SupplementLog[]
  schedules   SupplementSchedule[]
  occurrences SupplementDoseOccurrence[]

  @@unique([userId, supplementId])
  @@index([userId])
  @@index([ingredientId])
}

model SupplementLog {
  id String @id @default(uuid())

  userId           String
  userSupplementId String
  userSupplement   UserSupplement @relation(fields: [userSupplementId], references: [id], onDelete: Cascade)

  supplementName String
  quantity       Float  @default(1)
  calories       Float  @default(0)
  proteinG       Float  @default(0)
  carbsG         Float  @default(0)
  fatG           Float  @default(0)
  fiberG         Float  @default(0)

  // v2: link back to the scheduled occurrence this log fulfills (if any), plus
  // the user-confirmed dose actually taken and the effective timezone.
  occurrenceId   String?
  occurrence     SupplementDoseOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  amount         Float?
  unit           String?
  timezone       String?
  source         String                    @default("manual") // manual | reminder_action | quick_log
  // Client-generated key — prevents duplicate taken events on retry/offline.
  idempotencyKey String?                   @unique

  loggedAt DateTime @default(now())
  date     String

  @@index([userId, date])
  @@index([userSupplementId])
  @@index([occurrenceId])
}

// Central ingredient catalog shared across all users. Populated on demand from
// the USDA FoodData Central API and cached here so repeat lookups (by any user)
// are served from the DB instead of re-hitting USDA.
model Ingredient {
  id String @id @default(uuid())

  // USDA FoodData Central ID. Unique so upserts dedupe across users.
  fdcId String? @unique

  name           String
  // Lowercased name for case-insensitive contains lookups.
  normalizedName String

  // Nutrition normalized to 100g so any portion can be derived client-side.
  caloriesPer100g Float
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float

  source String @default("usda")

  createdAt DateTime @default(now())

  catalogId         String?                      @unique
  catalog           IngredientCatalog?           @relation(fields: [catalogId], references: [id], onDelete: Restrict)
  fiberPer100g      Float?
  sourceMetadata    Json?
  servings          IngredientServing[]
  nutritionProfiles IngredientNutritionProfile[]

  userLinks  UserIngredient[]
  attributes IngredientAttribute[]

  @@index([normalizedName])
}

// Per-user ingredient table: the set of ingredients a given user has searched.
// Lookups check this first, then the central Ingredient table, then USDA.
model UserIngredient {
  id String @id @default(uuid())

  userId String

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  favorite       Boolean   @default(false)
  selectedAt     DateTime?
  searchCount    Int       @default(1)
  lastSearchedAt DateTime  @default(now())

  createdAt DateTime @default(now())

  @@unique([userId, ingredientId])
  @@index([userId])
}

// ============================================================================
// SAFETY & RECOMMENDATION ENGINE
// ============================================================================

// Attributes that can be assigned to ingredients (e.g. HIGH_SUGAR, GOITROGENIC).
model IngredientAttribute {
  id String @id @default(uuid())

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  attribute String // e.g. HIGH_SUGAR, HIGH_GLYCEMIC, CONTAINS_GLUTEN, NUT, SHELLFISH, etc.

  createdAt DateTime @default(now())

  @@unique([ingredientId, attribute])
  @@index([attribute])
}

// Attributes that can be assigned to supplements (e.g. CONTAINS_CAFFEINE).
model SupplementAttribute {
  id String @id @default(uuid())

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  attribute String // e.g. CONTAINS_CAFFEINE, HIGH_SODIUM, BLOOD_THINNER_INTERACTION, etc.

  createdAt DateTime @default(now())

  @@unique([supplementId, attribute])
  @@index([attribute])
}

// Rules that map health conditions to blocked/warned ingredient or supplement attributes.
// action: "block" | "warn"
// target: "ingredient" | "supplement"
model ConditionRule {
  id String @id @default(uuid())

  conditionId String
  condition   HealthCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  // The attribute this rule targets (e.g. HIGH_SUGAR, CONTAINS_CAFFEINE).
  attribute String

  // "ingredient" or "supplement"
  target String

  // "block" (hard stop) or "warn" (soft warning)
  action String

  // Human-readable reason shown to the user.
  reason String?

  // Legacy attribute rules are not approved clinical evidence by default.
  ruleCode                String?              @unique
  clinicalAction          NutrientRuleAction?
  clinicalSeverity        NutrientRuleSeverity @default(INFO)
  applicabilityCriteria   Json?
  requiresPersonalization Boolean              @default(false)
  evidenceSourceId        String?              @db.Uuid
  evidence                RuleEvidence?        @relation(fields: [evidenceSourceId], references: [id], onDelete: Restrict)
  reviewStatus            ClinicalRuleReview   @default(DRAFT)
  version                 Int                  @default(1)
  reviewedBy              String?
  reviewedAt              DateTime?

  // Activation lifecycle — approval and activation are separate operations.
  // Consumers fire only on APPROVED + activeAt set + not retired/expired.
  activeAt    DateTime?
  activatedBy String?
  retiredAt   DateTime?
  expiresAt   DateTime?
  reviewDueAt DateTime?

  createdAt DateTime @default(now())

  @@unique([conditionId, attribute, target])
  @@index([conditionId])
}

// Supplement-specific timing/interaction rules (e.g. don't take calcium near thyroid meds).
model SupplementRule {
  id String @id @default(uuid())

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  conditionId String?
  condition   HealthCondition? @relation(fields: [conditionId], references: [id])

  // "timing" | "interaction" | "contraindication"
  ruleType String

  // Human-readable description.
  description String

  // For timing rules: minimum gap in hours.
  gapHours Float?

  // What it conflicts with (medication name, supplement name, food category).
  conflictsWith String?

  createdAt DateTime @default(now())
}

// Meal recommendations generated by the engine.
model MealRecommendation {
  id String @id @default(uuid())

  userId String

  mealType       String // breakfast, lunch, dinner, snack
  caloriesTarget Float
  proteinTarget  Float
  carbsTarget    Float?
  fatTarget      Float?

  // Recommended foods (JSON array of food suggestions).
  foods Json

  // The reasoning behind the recommendation.
  reasoning String?

  // Safety score (0-100). Higher = safer based on user's conditions.
  safetyScore Float @default(100)

  // Whether the user accepted/dismissed/acted on this.
  status String @default("pending") // pending, accepted, dismissed

  createdAt DateTime @default(now())

  violations RecommendationViolation[]

  @@index([userId, createdAt])
}

// Violations found during recommendation validation.
model RecommendationViolation {
  id String @id @default(uuid())

  recommendationId String?
  recommendation   MealRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  userId String

  // "ingredient" | "supplement" | "recipe" | "meal"
  entityType String
  entityName String

  // The attribute that was violated.
  attribute String

  // The condition that triggered the violation.
  conditionName String

  // "block" | "warn"
  severity String

  reason String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Audit log for all safety checks run by the system.
model SafetyAuditLog {
  id String @id @default(uuid())

  userId String

  // "meal_recommendation" | "recipe_validation" | "supplement_check" | "ingredient_check"
  checkType String

  // Input context (JSON).
  input Json?

  // Result (JSON).
  result Json?

  safetyScore Float?

  passed Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Supplement scheduling (dose, time, frequency, reminders).
// v2: multiple schedules per user supplement are supported — the former
// @@unique([userId, supplementId]) constraint was removed. `supplementId` is
// kept for legacy rows; new rows link through `userSupplementId`.
model SupplementSchedule {
  id String @id @default(uuid())

  userId String

  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  userSupplementId String?
  userSupplement   UserSupplement? @relation(fields: [userSupplementId], references: [id], onDelete: Cascade)

  dose       String? // legacy free-text dose, e.g. "5g", "1 capsule"
  // Structured dose (preferred for new rows).
  doseAmount Float?
  doseUnit   String? // mg | mcg | g | IU | mL | capsule | tablet | scoop | serving | CFU

  frequency  String @default("daily") // daily | specific_days | weekly | as_needed | custom
  // [0-6] weekdays for specific_days/weekly; null = every day.
  daysOfWeek Json?

  // ANY_TIME | WITH_MEAL | AFTER_MEAL | BEFORE_MEAL | EMPTY_STOMACH |
  // WITH_BREAKFAST | WITH_LUNCH | WITH_DINNER | BEFORE_BED | AFTER_WORKOUT |
  // FIXED_TIME | CUSTOM — a scheduling convenience, not medical direction.
  timingRelation String  @default("FIXED_TIME")
  mealAnchor     String? // breakfast | lunch | dinner | snack
  workoutAnchor  Boolean @default(false)

  // Legacy time-of-day label: "morning" | "afternoon" | "evening" | "with_meal" | "before_bed".
  timeOfDay String?

  // Fixed local time (HH:MM) for reminders.
  reminderTime String?
  // Fallback HH:MM used when an anchored event (meal/workout) hasn't happened.
  fallbackTime String?

  // FOLLOW_DEVICE | FIXED_TIMEZONE — mirrors ReminderPreference.timezoneMode.
  timezonePolicy String @default("FOLLOW_DEVICE")

  // YYYY-MM-DD bounds; null = open-ended.
  startDate String?
  endDate   String?

  active        Boolean @default(true)
  notifyEnabled Boolean @default(true) // per-schedule opt-in; nothing fires when false
