{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run db:generate"
  },
  "deploy": {
    "preDeployCommand": [
      "npm run deploy:prepare"
    ],
    "startCommand": "npm start",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120
  }
}
