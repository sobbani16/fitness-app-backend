{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pose-dataset-consent-record-v1",
  "title": "Subject consent + source-rights record",
  "type": "object",
  "required": ["schemaVersion", "subjectPseudonym", "consent", "sourceRights", "revocation"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "subjectPseudonym": { "type": "string", "minLength": 4, "maxLength": 80 },
    "consent": {
      "type": "object",
      "required": ["capturedAt", "scope", "document"],
      "additionalProperties": false,
      "properties": {
        "capturedAt": { "type": "string", "format": "date-time" },
        "scope": {
          "type": "array", "minItems": 1,
          "items": { "enum": ["training", "evaluation", "model_derivatives", "benchmark_publication"] }
        },
        "document": { "type": "string", "maxLength": 200, "description": "reference to the signed consent instrument (e.g. form id/version) — not the document itself" },
        "guardian": { "type": "boolean", "description": "true when consent was given by a guardian (minor)" }
      }
    },
    "sourceRights": {
      "type": "object",
      "required": ["kind", "acquiredAt"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["in_house_capture", "licensed_dataset", "subject_contributed", "public_domain"] },
        "licenseId": { "type": "string", "maxLength": 120, "description": "license reference — required for licensed_dataset" },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "rightsNotes": { "type": "string", "maxLength": 2000 },
        "termsReviewedBy": { "type": "string", "maxLength": 80 }
      }
    },
    "revocation": {
      "type": "object",
      "required": ["revocable", "channel"],
      "additionalProperties": false,
      "properties": {
        "revocable": { "type": "boolean" },
        "channel": { "type": "string", "maxLength": 200, "description": "how the subject revokes (e.g. in-app privacy center)" },
        "revokedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
