      "displayName": "Plank (timed hold)",
      "primaryLandmarks": ["left_shoulder", "right_shoulder", "left_hip", "right_hip", "left_ankle", "right_ankle", "left_elbow", "right_elbow"],
      "trackedAngles": [
        { "joint": "hip_line", "landmarks": ["shoulder", "hip", "ankle"], "standingRange": [165, 180], "bottomRange": [165, 180] }
      ],
      "phases": [
        { "name": "hold", "entry": "hip_line angle within standingRange sustained" },
        { "name": "broken", "entry": "hip_line angle outside 155-185 for >500ms" }
      ],
      "repCriteria": { "timed": true, "requiresPhases": ["hold"], "minBottomAngleKnee": null, "returnToStanding": false },
      "coachingCues": [
        { "fault": "hip_sag", "detector": "hip_line angle below 160", "cue": "Lift your hips — straight line", "severity": "high" },
        { "fault": "hip_pike", "detector": "hip_line angle above 185 sustained", "cue": "Lower your hips slightly", "severity": "low" }
      ]
    },
    {
      "id": "overhead_press",
      "displayName": "Overhead Press",
      "primaryLandmarks": ["left_shoulder", "right_shoulder", "left_elbow", "right_elbow", "left_wrist", "right_wrist", "left_hip", "right_hip"],
      "trackedAngles": [
        { "joint": "elbow", "landmarks": ["shoulder", "elbow", "wrist"], "standingRange": [70, 100], "bottomRange": [160, 180] },
        { "joint": "shoulder", "landmarks": ["elbow", "shoulder", "hip"], "standingRange": [20, 60], "bottomRange": [150, 180] }
      ],
      "phases": [
        { "name": "rack", "entry": "elbow angle within standingRange, wrist near shoulder height" },
