{
  "version": "1.0.0",
  "spec": "HUM-100 P4 — machine-readable exercise definitions consumed by the deterministic baseline, dataset annotation schema, and runtime coaching. Landmark names follow the BlazePose-33 vocabulary.",
  "exercises": [
    {
      "id": "squat",
      "displayName": "Squat",
      "primaryLandmarks": ["left_hip", "right_hip", "left_knee", "right_knee", "left_ankle", "right_ankle", "left_shoulder", "right_shoulder"],
      "trackedAngles": [
        { "joint": "knee", "landmarks": ["hip", "knee", "ankle"], "standingRange": [160, 180], "bottomRange": [70, 110] },
        { "joint": "hip", "landmarks": ["shoulder", "hip", "knee"], "standingRange": [160, 180], "bottomRange": [60, 110] }
      ],
      "phases": [
        { "name": "standing", "entry": "knee angle within standingRange" },
        { "name": "descent", "entry": "knee angle decreasing through 140" },
        { "name": "bottom", "entry": "knee angle within bottomRange" },
        { "name": "ascent", "entry": "knee angle increasing from bottom" }
      ],
      "repCriteria": { "requiresPhases": ["standing", "descent", "bottom", "ascent"], "minBottomAngleKnee": 110, "returnToStanding": true },
      "coachingCues": [
        { "fault": "knee_valgus", "detector": "knee x-position collapses medial to ankle during descent/ascent", "cue": "Push your knees out over your toes", "severity": "high" },
        { "fault": "shallow_depth", "detector": "rep ends without knee reaching bottomRange", "cue": "Sink lower — hips below knees", "severity": "medium" },
        { "fault": "forward_lean", "detector": "hip angle exceeds bottomRange upper bound +25 at bottom", "cue": "Keep your chest up", "severity": "medium" },
        { "fault": "heel_lift", "detector": "ankle y rises during descent", "cue": "Keep your heels planted", "severity": "low" }
      ]
    },
    {
      "id": "push_up",
      "displayName": "Push-Up",
      "primaryLandmarks": ["left_shoulder", "right_shoulder", "left_elbow", "right_elbow", "left_wrist", "right_wrist", "left_hip", "right_hip", "left_ankle", "right_ankle"],
      "trackedAngles": [
        { "joint": "elbow", "landmarks": ["shoulder", "elbow", "wrist"], "standingRange": [150, 180], "bottomRange": [70, 100] },
        { "joint": "hip_line", "landmarks": ["shoulder", "hip", "ankle"], "standingRange": [165, 180], "bottomRange": [165, 180] }
      ],
      "phases": [
        { "name": "plank_top", "entry": "elbow angle within standingRange" },
