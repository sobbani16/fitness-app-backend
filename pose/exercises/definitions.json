        { "fault": "partial_depth", "detector": "rep ends without elbow reaching bottomRange", "cue": "Lower your chest closer to the floor", "severity": "medium" },
        { "fault": "elbow_flare", "detector": "elbow-to-torso angle exceeds 70 degrees", "cue": "Tuck your elbows to about 45 degrees", "severity": "medium" }
      ]
    },
    {
      "id": "lunge",
      "displayName": "Lunge",
