        { "fault": "partial_lockout", "detector": "rep ends without elbow reaching lockout range", "cue": "Press fully overhead", "severity": "medium" },
        { "fault": "forward_head", "detector": "ear landmark deviates forward of shoulder midline during press", "cue": "Pull your head back as the bar passes", "severity": "low" }
      ]
    }
  ]
