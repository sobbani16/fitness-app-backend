        { "fault": "squatting_the_hinge", "detector": "knee angle leaves bottomRange lower bound during descent", "cue": "Soft knees, push hips back", "severity": "medium" },
        { "fault": "partial_lockout", "detector": "rep ends before hip returns to standingRange", "cue": "Squeeze your glutes to full stand", "severity": "low" }
      ]
    },
    {
