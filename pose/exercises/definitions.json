      "repCriteria": { "requiresPhases": ["standing", "descent", "bottom", "ascent"], "minBottomAngleKnee": 110, "returnToStanding": true },
      "coachingCues": [
        { "fault": "knee_past_toe", "detector": "front knee x-position advances beyond front ankle by >15% of shin length", "cue": "Keep your front knee stacked over your ankle", "severity": "high" },
        { "fault": "torso_lean", "detector": "shoulder-hip vertical alignment deviates >20 degrees", "cue": "Stay tall through your torso", "severity": "medium" },
        { "fault": "shallow_step", "detector": "rep ends without front knee reaching bottomRange", "cue": "Step deeper into the lunge", "severity": "low" }
      ]
    },
    {
      "id": "deadlift_hinge",
      "displayName": "Deadlift / Hip Hinge",
