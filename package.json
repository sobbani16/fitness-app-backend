{
  "name": "fitness-app-backend",
  "version": "0.1.0",
  "description": "Fitness app backend (Express, JS).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:seed-dummy": "node prisma/seed-dummy.js",
    "db:seed-safety": "node prisma/seed-safety.js",
    "db:deploy": "prisma migrate deploy",
    "db:seed-rbac": "node prisma/seed-rbac.js",
    "test:api": "node scripts/endpoint-smoke.js",
    "qa:auth": "node scripts/qa-auth.js",
    "test:auth": "jest --config jest.auth.config.js --runInBand",
    "deploy:prepare": "node scripts/deploy-prepare.js",
    "ingredients:import": "node scripts/import-ingredients.js",
    "deploy:check": "node scripts/check-deployment.js",
    "admin:provision": "node scripts/provision-admin.js",
    "ingredients:import:v5": "node scripts/import-ingredients-v5.js",
    "db:seed-nutrients": "node prisma/seed-nutrients.js",
    "nutrients:import": "node scripts/import-nutrients.js",
    "nutrients:fetch": "node scripts/fetch-nutrient-sources.js",
    "nutrients:populate": "node scripts/populate-nutrients.js",
    "conditions:import": "node scripts/import-condition-rules.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "openai": "^6.49.0",
    "prisma": "^6.19.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
