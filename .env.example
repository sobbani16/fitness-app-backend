PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local Homebrew Postgres typically uses your macOS username with no password.
DATABASE_URL="postgresql://sobbani@localhost:5432/fitness_app?schema=public"

# Spoonacular recipe search + nutrition. Get a free key at
# https://spoonacular.com/food-api. If unset, the app uses a built-in mock.
SPOONACULAR_API_KEY=

# USDA FoodData Central — ingredient search + nutrition. Get a free key at
# https://fdc.nal.usda.gov/api-key-signup.html. If unset, "DEMO_KEY" is used
# (heavily rate-limited) and the app falls back to a built-in mock on limits.
USDA_API_KEY=
