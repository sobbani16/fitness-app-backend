PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local Homebrew Postgres typically uses your macOS username with no password.
DATABASE_URL="postgresql://sobbani@localhost:5432/fitness_app?schema=public"

# Spoonacular recipe search + nutrition. Get a free key at
# https://spoonacular.com/food-api. If unset, the app uses a built-in mock.
SPOONACULAR_API_KEY=

# USDA FoodData Central — ingredient search + nutrition. Get a free key at
# https://fdc.nal.usda.gov/api-key-signup.html. If unset, "DEMO_KEY" is used
# (heavily rate-limited) and the app falls back to a built-in mock on limits.
USDA_API_KEY=

# Required for auth lifecycle. Generate AUTH_LINK_SECRET with: openssl rand -hex 32
# HTTPS API origin, hosting /auth/action. HTTP localhost allowed outside production.
AUTH_PUBLIC_URL=http://localhost:4000
AUTH_LINK_SECRET=
RESEND_API_KEY=
# Use an address on a domain verified in Resend. Disable email click tracking.
AUTH_EMAIL_FROM=Fitness <accounts@example.com>

# Server only. Never use EXPO_PUBLIC_ for this key. No calls are made without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Persistent UTC daily attempt budgets shared by /meals/detect and /meals/analyze.
# Failures count; 0 disables food AI. Global budget spans all users/server instances.
FOOD_AI_USER_DAILY_LIMIT=30
FOOD_AI_GLOBAL_DAILY_LIMIT=100
