PORT=4000
NODE_ENV=development

# PostgreSQL connection used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local Homebrew Postgres typically uses your macOS username with no password.
DATABASE_URL="postgresql://sobbani@localhost:5432/fitness_app?schema=public"

# Spoonacular recipe search + nutrition. Get a free key at
# https://spoonacular.com/food-api. If unset, the app uses a built-in mock.
SPOONACULAR_API_KEY=

# USDA FoodData Central — ingredient search + nutrition. Get a free key at
# https://fdc.nal.usda.gov/api-key-signup.html. If unset, "DEMO_KEY" is used
# (heavily rate-limited) and the app falls back to a built-in mock on limits.
USDA_API_KEY=

# Required for auth lifecycle. Generate AUTH_LINK_SECRET with: openssl rand -hex 32
# HTTPS API origin, hosting /auth/action. HTTP localhost allowed outside production.
AUTH_PUBLIC_URL=http://localhost:4000
AUTH_LINK_SECRET=
RESEND_API_KEY=
# Use an address on a domain verified in Resend. Disable email click tracking.
AUTH_EMAIL_FROM=Fitness <accounts@example.com>

# Server only. Never use EXPO_PUBLIC_ for this key. No calls are made without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Explicit server opt-in required for food estimates, Leo, and workout drafts.
AI_ENABLED=false
# Process-local attempt/token caps (not durable across restarts or replicas).
AI_USER_DAILY_CALL_CAP=20
AI_USER_DAILY_TOKEN_CAP=50000
# Persistent UTC daily attempt budgets shared by /meals/detect and /meals/analyze.
# Failures count; 0 disables food AI. Global budget spans all users/server instances.
FOOD_AI_USER_DAILY_LIMIT=30
FOOD_AI_GLOBAL_DAILY_LIMIT=100

# --- Feature flags (see docs/FEATURE_FLAG_IMPLEMENTATION_PLAN.md) -----------
# PostHog project token (phc_...) — server-side only, never EXPO_PUBLIC_.
# PostHog evaluates targeting/rollouts; the backend enforces the registry.
POSTHOG_API_KEY=
# US cloud: https://us.i.posthog.com — EU cloud: https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# 'posthog' | 'env' (defaults + FF_* overrides only) | 'off' (defaults only).
# Unset => 'posthog' when POSTHOG_API_KEY present, else 'env'.
FEATURE_FLAGS_PROVIDER=
# Per-user flag evaluation cache — also bounds kill-switch propagation delay.
FF_CACHE_TTL_MS=60000
# Guaranteed AI kill-switch backstop: forces every group:'ai' flag off even if
# PostHog is unreachable. Set 'true' then restart the service.
AI_EMERGENCY_SHUTDOWN=false
# Per-flag env overrides beat PostHog (e.g. FF_TRAINER_DASHBOARD=true).
# Names: FF_ + SCREAMING_SNAKE flag key from src/config/featureRegistry.js.

# --- Previously undocumented vars (audit) -----------------------------------
# Browser origins allowed to call the API (comma-separated). Unset => non-browser only.
CORS_ORIGINS=
# Trust this many X-Forwarded-For hops when behind a proxy (Railway sets one).
TRUST_PROXY_HOPS=
# Global requests/minute per IP. Default 120.
API_RATE_LIMIT=
# Mount /api-docs Swagger UI. Keep false outside staging.
ENABLE_API_DOCS=false
# Leo chat per-user daily limit.
CHAT_DAILY_LIMIT=5
# Whisper-class model for POST /voice/transcribe.
VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# YouTube Data API key for /videos/search.
YOUTUBE_API_KEY=
# Test-only auth bypass. Startup hard-fails if set in production.
AUTH_TEST_BYPASS=false

# Coaching communication platform
DOCUMENT_STORAGE_DIR=var/uploads
DOCUMENT_MAX_BYTES=10485760
# Malware scanner: external command run per upload (e.g. 'clamdscan --fdpass').
# When empty, scanning is skipped unless DOC_SCAN_REQUIRED=true (then uploads
# fail closed until a scanner is configured).
DOC_SCAN_CMD=
DOC_SCAN_REQUIRED=false
AUTH_LINK_SECRET=dev-doc-secret

# Video provider — when all three are set, /video-sessions/:id/join returns a
# real 15-min LiveKit JWT (room-join only); otherwise a humai-dev credential.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Private document storage — when S3_BUCKET is set, uploads go to the bucket
# (S3 or R2 via S3_ENDPOINT); otherwise local DOCUMENT_STORAGE_DIR is used.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=

# Retention sweep (run via cron — see docs/PRODUCTION_RUNBOOK.md)
GROUP_MSG_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=365
DOC_REVOKED_RETENTION_DAYS=90
SESSION_TEXT_RETENTION_DAYS=180
