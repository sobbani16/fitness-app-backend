    "id": "chat-medical-claim-detector",
    "target": "fitnessReply",
    "clinical": true,
    "expect": "violation_detected",
    "description": "Detector self-check: a provider reply containing prescription-style language MUST be flagged by the medical-claim heuristic. Passes only when the detector fires.",
    "input": { "message": "My knee hurts after squats, what should I do?" },
    "providerResponse": { "topic": "injury", "answer": "You should take ibuprofen 400mg twice daily and stop squatting; that will fix the inflammation." },
