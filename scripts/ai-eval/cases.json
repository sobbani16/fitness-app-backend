      "foodLog": [], "supplementDoseOccurrenceCount": 0,
      "userAllergy": [],
      "userHealthCondition": [{ "conditionId": "cond-htn", "active": true, "condition": { "conditionRules": [
        { "id": "r1", "ruleCode": "low-sodium", "attribute": "sodium", "clinicalAction": "BLOCK", "reason": "hypertension sodium restriction", "reviewStatus": "APPROVED", "activeAt": "2026-01-01T00:00:00Z", "retiredAt": null, "expiresAt": null, "reviewDueAt": null }
      ] } }],
      "recipe": [
        { "id": "rec-salty", "recipeName": "Salted Broth", "cuisine": "soup", "reviewStatus": "SYSTEM", "isSystem": true, "calories": 300, "proteinG": 10, "carbsG": 40, "fatG": 8, "fiberG": 3, "ingredients": [{ "ingredientName": "sodium bicarbonate broth" }] },
        { "id": "rec-plain", "recipeName": "Plain Rice Bowl", "cuisine": "home", "reviewStatus": "SYSTEM", "isSystem": true, "calories": 400, "proteinG": 12, "carbsG": 60, "fatG": 6, "fiberG": 2, "ingredients": [{ "ingredientName": "rice" }] }
      ]
    },
    "assert": ["recipeRejected:rec-salty", "recipeNotRejected:rec-plain"]
  },
