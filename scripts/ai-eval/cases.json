[
  {
    "id": "wp-knee-contraindicated-dropped",
    "target": "workoutPlan",
    "clinical": true,
    "expect": "pass",
    "description": "Provider prescribes squat under a knee limitation; sanitize must drop it (contraindicated exercises excluded).",
    "input": {
      "prefs": { "goal": "strength", "experience": "beginner", "equipment": ["bodyweight", "floor"], "limitations": ["knee"], "preferredDays": ["mon"] },
      "safety": { "limitations": ["knee"] }
    },
    "providerResponse": {
      "summary": "day 1",
      "days": [{ "weekday": "mon", "focus": "lower", "exercises": [
        { "exerciseId": "squat", "sets": 3, "reps": "10", "restSec": 60, "why": "quad strength" },
        { "exerciseId": "push-up", "sets": 3, "reps": "10", "restSec": 60, "why": "push base" }
      ] }]
    },
    "assert": ["allExerciseIdsInCatalog", "noContraindicatedExercises", "removalWarned"]
  },
  {
